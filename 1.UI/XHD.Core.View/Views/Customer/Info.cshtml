@{
    ViewData["Title"] = "Add";
}

<style type="text/css">
    .downpanel .layui-select-title span { line-height: 38px; }

    /*继承父类颜色*/
    .downpanel dl dd:hover { background-color: inherit; }

    #treeclass { width: 190px; }

    body .layui-layer-content { overflow: visible; }

    #toolbar { padding: 5px 0; }

    /* 客户画像 */
    .cust-hero { display: flex; align-items: center; background: linear-gradient(135deg, #0f766e 0%, #0ea5e9 100%); color: #fff; border-radius: 10px; padding: 20px 24px; margin-bottom: 14px; box-shadow: 0 8px 22px rgba(14, 165, 233, .22); }
    .cust-avatar { width: 62px; height: 62px; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: 700; margin-right: 18px; }
    .cust-main { flex: 1; }
    .cust-name { font-size: 24px; font-weight: 700; letter-spacing: 1px; }
    .cust-tags { margin-top: 8px; }
    .cust-tag { display: inline-block; padding: 1px 10px; margin: 0 6px 4px 0; border-radius: 10px; background: rgba(255,255,255,.18); font-size: 12px; }
    .cust-sub { margin-top: 6px; font-size: 13px; opacity: .9; }
    .cust-health { text-align: center; min-width: 120px; }
    .cust-health .score { font-size: 36px; font-weight: 800; line-height: 1; }
    .cust-health .label { font-size: 12px; opacity: .9; margin-top: 6px; }

    /* KPI */
    .crm-kpi-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .crm-kpi { flex: 1 1 150px; background: #fff; border-radius: 8px; padding: 14px 16px; box-shadow: 0 1px 4px rgba(15,23,42,.06); border-top: 3px solid #1677ff; }
    .crm-kpi .label { color: #6b7280; font-size: 12px; }
    .crm-kpi .value { font-size: 21px; font-weight: 700; color: #111827; margin-top: 5px; font-variant-numeric: tabular-nums; }
    .crm-kpi .sub { color: #9ca3af; font-size: 11px; margin-top: 3px; }
    .crm-kpi.green { border-top-color: #16a34a; }
    .crm-kpi.red { border-top-color: #ef4444; }
    .crm-kpi.purple { border-top-color: #7c3aed; }
    .crm-kpi.orange { border-top-color: #f59e0b; }
    .crm-kpi.cyan { border-top-color: #0ea5e9; }

    .analysis-panel { background: #fff; border-radius: 8px; padding: 16px 18px; box-shadow: 0 1px 4px rgba(15,23,42,.06); margin-bottom: 14px; }
    .analysis-title { font-size: 15px; font-weight: 700; color: #1f2937; margin-bottom: 10px; padding-left: 10px; border-left: 4px solid #0ea5e9; }
    .insight-list { list-style: none; margin: 0; padding: 0; }
    .insight-list li { padding: 9px 0; border-bottom: 1px dashed #e5e7eb; color: #4b5563; font-size: 13px; }
    .insight-list li:last-child { border-bottom: none; }
    .insight-list li i { color: #0ea5e9; margin-right: 6px; }
    .analysis-timeline { position: relative; margin-left: 8px; padding-left: 18px; border-left: 2px solid #e5e7eb; }
    .analysis-timeline .item { position: relative; padding-bottom: 14px; }
    .analysis-timeline .item::before { content: ''; position: absolute; left: -25px; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #0ea5e9; }
    .analysis-timeline .item .t-title { font-weight: 600; color: #1f2937; font-size: 13px; }
    .analysis-timeline .item .t-desc { color: #4b5563; font-size: 13px; margin-top: 3px; }
    .analysis-timeline .item .t-time { color: #9ca3af; font-size: 12px; margin-top: 3px; }
</style>


<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")
    @Html.Hidden("emp_id")

    <div class="cust-hero" id="custHero">
        <div class="cust-avatar" id="heroAvatar">客</div>
        <div class="cust-main">
            <div class="cust-name" id="heroName">客户详情</div>
            <div class="cust-tags" id="heroTags"></div>
            <div class="cust-sub" id="heroSub">正在加载客户资料…</div>
        </div>
        <div class="cust-health">
            <div class="score" id="heroHealthScore">--</div>
            <div class="label" id="heroHealthLabel">客户健康分</div>
        </div>
    </div>

    <div class="crm-kpi-row">
        <div class="crm-kpi">
            <div class="label">累计订单金额</div>
            <div class="value" id="kpiOrderAmount">¥0.00</div>
            <div class="sub" id="kpiOrderCount">共 0 笔订单</div>
        </div>
        <div class="crm-kpi green">
            <div class="label">累计回款</div>
            <div class="value" id="kpiReceived">¥0.00</div>
            <div class="sub" id="kpiPayRate">回款率 0%</div>
        </div>
        <div class="crm-kpi red">
            <div class="label">应收余额</div>
            <div class="value" id="kpiArrears">¥0.00</div>
            <div class="sub" id="kpiOverdue">逾期计划 0 期</div>
        </div>
        <div class="crm-kpi purple">
            <div class="label">合同金额</div>
            <div class="value" id="kpiContractAmount">¥0.00</div>
            <div class="sub" id="kpiContractCount">共 0 份合同</div>
        </div>
        <div class="crm-kpi orange">
            <div class="label">跟进次数</div>
            <div class="value" id="kpiFollowCount">0</div>
            <div class="sub" id="kpiLastFollow">最近跟进：--</div>
        </div>
        <div class="crm-kpi cyan">
            <div class="label">平均客单价</div>
            <div class="value" id="kpiAvgOrder">¥0.00</div>
            <div class="sub" id="kpiRepeat">复购 0 次</div>
        </div>
    </div>


    <div class="layui-card">
        <div class="layui-card-header">客户信息</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">客户名</label>
                    <div class="layui-input-inline">
                        <input type="text" name="cus_name" id="cus_name" placeholder="客户名" autocomplete="off" class="layui-input" disabled>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">电话</label>
                    <div class="layui-input-inline">
                        <input type="text" name="cus_tel" id="cus_tel" placeholder="电话" autocomplete="off" class="layui-input" disabled>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">传真</label>
                    <div class="layui-input-inline">
                        <input type="text" name="cus_fax" id="cus_fax" placeholder="传真" autocomplete="off" class="layui-input" disabled>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">网站</label>
                    <div class="layui-input-inline">
                        <input type="text" name="cus_website" id="cus_website" placeholder="网站" autocomplete="off" class="layui-input" disabled>
                    </div>
                </div>

                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">行业</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="cus_industry_val" id="cus_industry_val" placeholder="行业" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @*<select id="cus_industry_id" name="cus_industry_id" >
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">类型</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="cus_type_val" id="cus_type_val" placeholder="类型" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @*<select id="cus_type_id" name="cus_type_id">
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">级别</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="cus_level_val" id="cus_level_val" placeholder="级别" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @* <select id="cus_level_id" name="cus_level_id">
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">来源</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="cus_source_val" id="cus_source_val" placeholder="来源" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @*<select id="cus_source_id" name="cus_source_id">
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">省份</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="Provinces_val" id="Provinces_val" placeholder="省份" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @*<select id="Provinces_id" name="Provinces_id" lay-filter="Provinces">
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label " style="padding-left:0px;">城市</label>
                    <div class="layui-input-inline">
                        <div class="layui-input-inline">
                            <input type="text" name="City_val" id="City_val" placeholder="城市" autocomplete="off" class="layui-input" disabled>
                        </div>
                        @*<select id="City_id" name="City_id">
                            <option value="">请选择</option>
                            </select>*@
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">状态</label>
                    <div class="layui-input-inline">
                        <select id="isPrivate" name="isPrivate" autocomplete="off" class="layui-input  layui-disabled" disabled>
                            <option value="">请选择</option>
                            <option value=0>私客</option>
                            <option value=1>公客</option>
                        </select>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">归属</label>
                    <div class="layui-input-inline">
                        <input type="text" name="employee" id="employee" placeholder="归属" autocomplete="off" class="layui-input" disabled>
                    </div>
                </div>

            </div>
            <div class="layui-form-item">
                <label class="layui-form-label ">描述</label>
                <div class="layui-input-block">
                    <input type="text" name="DesCripe" id="DesCripe" placeholder="描述" autocomplete="off" class="layui-input" disabled>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label ">地址</label>
                <div class="layui-input-block">
                    <input type="text" name="cus_add" id="cus_add" placeholder="地址" autocomplete="off" class="layui-input" disabled>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label ">备注</label>
                <div class="layui-input-block">
                    <input type="text" name="Remarks" id="Remarks" placeholder="备注" autocomplete="off" class="layui-input" disabled>
                </div>
            </div>
            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>


        </div>
    </div>

    <div class="layui-tab layui-tab-card" style="background:#fff;" id="colcse" lay-filter="xhdtab">
        <ul class="layui-tab-title"></ul>
        <div class="layui-tab-content">
        </div>
    </div>

</div>
<script type="text/html" id="toolbarDemo">
    <div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add">添加</button>
    </div>
</script>

<!-- 操作列 -->
<script type="text/html" id="auth-state">

    <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">修改</a>
    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
</script>
<script src="~/js/home/echarts.min.js"></script>
<script>
    var id = null;
    var customer_id = null;
    var customer_name = null;
    var currentTab = "analysis";
    var analysisData = null;
    var analysisResizeBound = false;
    layui.use(['tree', 'form', 'layer', 'tableSelect', 'table', 'laydate', 'element','openTable'], function () {
        var form = layui.form,
            tree = layui.tree,
            layer = layui.layer,
            $ = layui.$;
        var table = layui.table;
        var laydate = layui.laydate;
        var element = layui.element;
        var tableSelect = layui.tableSelect;
        var openTable=layui.openTable;

        //下拉
        $.ajax({
            url: "Grid",
            data: { id: getparastr("id") },
            type: "get",
            dataType: "json",
            success: function (data) {
                if (data.count > 0) {
                    var edit = data.data[0];
                    for (var val in edit) {
                        var value = edit[val];
                        if (isNaN(value) && !isNaN(Date.parse(value))) {
                            value = value.replace(' 00:00:00', '');
                        }
                        $("#" + val).val(value);
                    }
                    edit.cus_industry && $("#cus_industry_val").val(edit.cus_industry.params_name);
                    edit.cus_type && $("#cus_type_val").val(edit.cus_type.params_name);
                    edit.cus_level && $("#cus_level_val").val(edit.cus_level.params_name);
                    edit.cus_source && $("#cus_source_val").val(edit.cus_source.params_name);
                    edit.Provinces && $("#Provinces_val").val(edit.Provinces.Provinces);
                    edit.City && $("#City_val").val(edit.City.City);
                    edit.Employee && $("#employee").val(edit.Employee.name);

                    customer_id = edit.id;
                    customer_name = edit.cus_name;

                    renderHero(edit);
                    loadAnalysis();
                }
                form.render();
            },
        });

        var active = {
            tabAdd: function (title, id) {
                element.tabAdd("xhdtab", {
                    title: title,
                    content: "",
                    id: id
                });
            },
            tabChange: function (id) {
                //切换到指定Tab项
                element.tabChange('xhdtab', id); //根据传入的id传入到指定的tab项


            },
        }

        element.on('tab(xhdtab)', function () {
            var id = this.getAttribute('lay-id');

            console.log(id);
            currentTab = id;

            switch (id) {
                case "analysis": create_analysis(); break;
                case "contact": create_contact(); break;
                case "follow": create_follow(); break;
                case "order": create_order(); break;
                case "contract": create_contract(); break;
                case "receive": create_receive(); break;
                case "atta": create_atta(); break;
                case "log": create_log(); break;
            }
        });
        active.tabAdd("客户分析", "analysis");
        active.tabAdd("联系人", "contact");
        active.tabAdd("跟进", "follow");
        active.tabAdd("订单", "order");
        active.tabAdd("合同", "contract");
        active.tabAdd("收款", "receive");
        active.tabAdd("日志", "log");
        active.tabChange("analysis");
        setTimeout(function () {
            if (currentTab === "analysis") create_analysis();
        }, 60);


        function create_log()
        {
            if ($("#table_log").length == 0) {
                $(".layui-show").append("<div id='table_log' lay-filter='table_log_Filter'></div>");
            }

            // 渲染表格
            layer.load(2);
            openTable.render({
                elem: '#table_log',
                url: '/SysLog/Grid?customer_id=' + getparastr("id"),
                //toolbar: '#toolbarDemo',
                defaultToolbar: ['filter'],
                id: "mainGrid1",
                cols: [[
                    //{ type: "checkbox", width: 50, fixed: "left" },
                    //{ field: 'id', width: 80, title: 'ID', sort: true },
                    { type: 'numbers' },
                    { field: 'EventType', width: 180, title: '日志类型' },
                    { field: 'EventTitle', minWidth: 180, title: '标题' },
                    { field: 'UserName', width: 180, title: '操作人' },
                    { field: 'EventDate', width: 180, title: '操作时间' },
                    { field: 'IPStreet', width: 180, title: 'IP' },
                    //{ field: 'Log_Content', title: '内容', minWidth: 150 }
                    //{ templet: '#auth-state', width: 80, align: 'center', title: '操作'}

                ]],
                openCols: [
                    { field: 'Log_Content', title: '内容' }
                ],
                limits: [10, 15, 20, 25, 50, 100],
                limit: 15,
                page: true,
                done: function () {
                    layer.closeAll('loading');
                }
            });
        }

        function create_contact() {
            if ($("#table_contact").length == 0) {
                $(".layui-show").append("<div id='table_contact' lay-filter='table_contact_Filter'></div>");
            }

            // 渲染表格
            layer.load(2);
            table.render({
                elem: '#table_contact',
                url: '/CRM_Contact/Grid?customer_id=' + getparastr("id"),
                id: 'table_contact',
                page: false,
                toolbar: '#toolbarDemo',
                defaultToolbar: ['filter'],
                cols: [[
                    { type: 'numbers', fixed: 'left' ,title:"序号" },
                    { field: 'C_name', width: 100, title: '联系人', fixed: 'left' },
                    {
                        field: 'C_tel', width: 150, title: '电话', templet: function (item) {
                            var html = "<i class='fa fa-phone'></i>";
                            if (item.C_tel)
                                html += item.C_tel;

                            return html;
                        }
                    },
                    {
                        field: 'cus_name', width: 250, title: '客户', templet: function (t) {
                            if (t.customer) {
                                return t.customer.cus_name;
                            }
                            return "";
                        }
                    },
                    {
                        field: 'C_weichat', width: 180, title: '微信', templet: function (item) {
                            var html = "<i class='fa fa-comments'></i>";
                            if (item.C_weichat)
                                html += item.C_weichat;

                            return html;
                        }
                    },
                    {
                        field: 'C_email', width: 180, title: '邮箱', templet: function (item) {
                            var html = "<i class='fa fa-envelope'></i>";
                            if (item.C_weichat)
                                html += item.C_weichat;

                            return html;
                        }
                    },
                    { field: 'create_time', width: 180, title: '创建时间' },
                    {
                        field: 'Creater', width: 150, title: '创建人', templet: function (t) {
                            if (t.Creater) {
                                return t.Creater.name;
                            }
                            return "";
                        }
                    },
                    { templet: '#auth-state', width: 200, align: 'center', fixed: "right", title: '操作' }
                ]],
                limits: [10, 15, 20, 25, 50, 100],
                limit: 15,
                page: true,
                done: function () {
                    layer.closeAll('loading');
                }
            });

            /**
      * toolbar监听事件
      */
            table.on('toolbar(table_contact_Filter)', function (obj) {
                if (obj.event === 'add') {  // 监听添加操作
                    contact_add();
                    return;
                }
            });

            //监听工具条
            table.on('tool(table_contact_Filter)', function (obj) {
                var data = obj.data;
                var layEvent = obj.event;

                if (layEvent === 'del') {
                    layer.confirm('确定删除？', { icon: 3, title: '提示信息' }, function (index) {
                        contact_del(data.id);
                        layer.close(index);
                    });

                    //layer.msg('删除' + data.id);
                }
                else if (layEvent === 'edit') {
                    contact_add(data);
                }

            });

            function contact_del(id) {
                $.ajax({
                    type: 'POST',
                    url: "/CRM_Contact/Delete",
                    data: { id: id },
                    dataType: "json",
                    success: function (res) {//res为相应体,function为回调函数
                        f_reload("table_contact");
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                    }
                });
            }


            //添加目录
            function contact_add(edit) {
                var tit = "添加";
                if (edit) {
                    tit = "编辑";
                }
                var index = layui.layer.open({
                    title: tit,
                    type: 2,
                    anim: 1,
                    area: ['80%', '80%'],
                    maxmin: true,
                    content: "/CRM_Contact/Add",
                    btn: ['确定', '关闭'],
                    success: function (layero, index) {
                        var iframe = window["layui-layer-iframe" + index];
                        var body = layui.layer.getChildFrame('body', index);
                        if (edit) {
                            for (var val in edit) {
                                var value = edit[val];
                                if (isNaN(value) && !isNaN(Date.parse(value))) {
                                    value = value.replace(' 00:00:00', '');
                                }
                                body.find("#" + val).val(value);
                            }
                            //body.find("#customer_val").val(edit.customer_id);
                            body.find("#customer_name").val(edit.customer.cus_name);
                        }
                        else {
                            body.find("#customer_id").val(customer_id);
                            body.find("#customer_name").val(customer_name);
                        }
                    },
                    yes: function (index, layero) {
                        //var res = window["layui-layer-iframe" + index].callbackdata();
                        ////打印返回的值，看是否有我们想返回的值。
                        //console.log(res);
                        //layer.close(index);
                        var iframeWindow = window['layui-layer-iframe' + index]
                            , submitID = 'LAY-user-front-submit'
                            , submit = layero.find('iframe').contents().find('#' + submitID);

                        //监听提交
                        iframeWindow.layui.form.on('submit(' + submitID + ')', function (data) {
                            var field = data.field; //获取提交的字段

                            console.log(data.field);

                            layer.close(index); //关闭弹层

                            $.ajax({
                                type: 'POST',
                                url: '/CRM_Contact/Save',
                                data: data.field,
                                dataType: "json",
                                success: function (res) {//res为相应体,function为回调函数
                                    f_reload("table_contact");
                                },
                                error: function (XMLHttpRequest, textStatus, errorThrown) {
