        function renderHero(edit) {
            var name = edit.cus_name || "客户";
            $("#heroName").text(name);
            $("#heroAvatar").text(name.substring(0, 1));

            var tags = [];
            if (edit.cus_industry) tags.push(edit.cus_industry.params_name);
            if (edit.cus_type) tags.push(edit.cus_type.params_name);
            if (edit.cus_level) tags.push(edit.cus_level.params_name);
            if (edit.cus_source) tags.push(edit.cus_source.params_name);
            tags.push(edit.isPrivate == 1 ? "公客" : "私客");
            $("#heroTags").html(tags.map(function (t) {
                return '<span class="cust-tag">' + t + '</span>';
            }).join(""));

            var region = [];
            if (edit.Provinces) region.push(edit.Provinces.Provinces);
            if (edit.City) region.push(edit.City.City);

            var sub = [];
            sub.push("归属：" + (edit.Employee ? edit.Employee.name : "未分配"));
            if (edit.cus_tel) sub.push("电话：" + edit.cus_tel);
            if (region.length) sub.push("地区：" + region.join(" / "));
            if (edit.lastfollow) sub.push("最近跟进：" + String(edit.lastfollow).split(" ")[0]);
            $("#heroSub").html(sub.join(" &nbsp;·&nbsp; "));
        }

        function loadAnalysis() {
            $.ajax({
                url: "Analysis",
                data: { id: getparastr("id") },
                type: "get",
                dataType: "json",
                success: function (res) {
                    if (res.code === 0 && res.data && res.data[0]) {
                        analysisData = res.data[0];
                        renderKpi(analysisData);
                        if (currentTab === "analysis") create_analysis();
                    }
                }
            });
        }

        function renderKpi(d) {
            var k = d.kpi;
            $("#kpiOrderAmount").text("¥" + toMoney(k.orderAmount));
            $("#kpiOrderCount").text("共 " + k.orderCount + " 笔订单");
            $("#kpiReceived").text("¥" + toMoney(k.received));
            $("#kpiPayRate").text("回款率 " + k.payRate + "%");
            $("#kpiArrears").text("¥" + toMoney(k.arrears));
            $("#kpiOverdue").text("逾期计划 " + k.overdueCount + " 期");
            $("#kpiContractAmount").text("¥" + toMoney(k.contractAmount));
            $("#kpiContractCount").text("共 " + k.contractCount + " 份合同");
            $("#kpiFollowCount").text(k.followCount);
            $("#kpiLastFollow").text("最近跟进：" + (k.lastFollowTime || "--"));
            $("#kpiAvgOrder").text("¥" + toMoney(k.avgOrder));
            $("#kpiRepeat").text("复购 " + k.repeatOrders + " 次");

            $("#heroHealthScore").text(d.health.score).css("color", d.health.color);
            $("#heroHealthLabel").text(d.health.label);
        }

