                    '  </div>' +
                    '  <div class="layui-row layui-col-space14">' +
                    '    <div class="layui-col-md4"><div class="analysis-panel"><div class="analysis-title">收款方式分布</div><div id="custPayTypeChart" style="height:280px;"></div></div></div>' +
                    '    <div class="layui-col-md4"><div class="analysis-panel"><div class="analysis-title">产品偏好</div><div id="custProductChart" style="height:280px;"></div></div></div>' +
                    '    <div class="layui-col-md4"><div class="analysis-panel"><div class="analysis-title">客户洞察</div><ul class="insight-list" id="custInsights"></ul></div></div>' +
                    '  </div>' +
                    '  <div class="analysis-panel"><div class="analysis-title">最近动态</div><div class="analysis-timeline" id="custTimeline"></div></div>' +
                    '</div>';
                $(".layui-show").append(html);
            }

            if (!analysisData || typeof echarts === "undefined") return;

            var d = analysisData;
            var healthDom = document.getElementById("custHealthChart");
            if (healthDom) {
                var healthChart = echarts.getInstanceByDom(healthDom) || echarts.init(healthDom);
                healthChart.setOption({
                    series: [{
                        type: 'gauge',
                        startAngle: 210,
                        endAngle: -30,
                        min: 0,
                        max: 100,
                        radius: '92%',
                        progress: { show: true, width: 16, itemStyle: { color: d.health.color } },
                        axisLine: { lineStyle: { width: 16, color: [[1, '#eef2f7']] } },
                        pointer: { show: false },
                        axisTick: { show: false },
                        splitLine: { show: false },
                        axisLabel: { show: false },
                        title: { offsetCenter: [0, '30%'], fontSize: 13, color: '#6b7280' },
                        detail: { valueAnimation: true, offsetCenter: [0, '-5%'], fontSize: 40, fontWeight: 'bold', color: d.health.color, formatter: '{value}' },
                        data: [{ value: d.health.score, name: d.health.label }]
                    }]
                }, true);
            }

            var trendDom = document.getElementById("custTrendChart");
            if (trendDom) {
                var trendChart = echarts.getInstanceByDom(trendDom) || echarts.init(trendDom);
                trendChart.setOption({
                    tooltip: { trigger: 'axis', valueFormatter: function (v) { return '¥' + Number(v).toLocaleString(); } },
                    legend: { data: ['订单金额', '回款金额'], top: 0 },
                    grid: { left: 60, right: 24, top: 40, bottom: 30 },
                    xAxis: { type: 'category', boundaryGap: false, data: d.trend.months },
                    yAxis: { type: 'value' },
                    series: [
                        { name: '订单金额', type: 'line', smooth: true, symbolSize: 6, data: d.trend.orderAmount, itemStyle: { color: '#1677ff' }, areaStyle: { opacity: .12 } },
                        { name: '回款金额', type: 'line', smooth: true, symbolSize: 6, data: d.trend.receiveAmount, itemStyle: { color: '#16a34a' }, areaStyle: { opacity: .12 } }
                    ]
                }, true);
            }

            var payDom = document.getElementById("custPayTypeChart");
            if (payDom) {
                var payChart = echarts.getInstanceByDom(payDom) || echarts.init(payDom);
                var colors = ['#1677ff', '#16a34a', '#f59e0b', '#ef4444', '#7c3aed', '#0ea5e9'];
                payChart.setOption({
                    tooltip: { trigger: 'item', formatter: '{b}: ¥{c} ({d}%)' },
                    legend: { bottom: 0, type: 'scroll' },
                    series: [{
                        type: 'pie',
                        radius: ['32%', '62%'],
                        center: ['50%', '45%'],
                        data: (d.payTypes || []).map(function (p, i) {
                            return { name: p.name, value: p.value, itemStyle: { color: colors[i % colors.length] } };
                        })
                    }]
                }, true);
            }

            var productDom = document.getElementById("custProductChart");
            if (productDom) {
                var productChart = echarts.getInstanceByDom(productDom) || echarts.init(productDom);
                var pcolors = ['#0ea5e9', '#16a34a', '#f59e0b', '#ef4444', '#7c3aed', '#1677ff', '#ec4899', '#84cc16'];
                productChart.setOption({
                    tooltip: { trigger: 'item', formatter: '{b}: ¥{c} ({d}%)' },
                    legend: { bottom: 0, type: 'scroll' },
                    series: [{
                        type: 'pie',
                        radius: '62%',
                        center: ['50%', '45%'],
                        data: (d.products || []).map(function (p, i) {
                            return { name: p.name, value: p.value, itemStyle: { color: pcolors[i % pcolors.length] } };
                        })
                    }]
                }, true);
            }

            // 客户洞察
            var k = d.kpi;
            var insights = [];
            if (k.arrears > 0) insights.push("尚有 ¥" + toMoney(k.arrears) + " 未回款，建议优先跟进回款节点。");
            if (k.overdueCount > 0) insights.push("有 " + k.overdueCount + " 期收款计划已逾期，请核对收款安排。");
            if (k.lastFollowDays < 0) insights.push("暂无跟进记录，建议尽快建立首次联系。");
            else if (k.lastFollowDays > 30) insights.push("已 " + k.lastFollowDays + " 天未跟进，建议安排回访。");
            else insights.push("最近 " + k.lastFollowDays + " 天内有过跟进，客户关系维护良好。");
            if (k.repeatOrders > 0) insights.push("客户已复购 " + k.repeatOrders + " 次，属于重点维护客户。");
            if (k.orderCount === 0) insights.push("客户尚未成交，建议加强需求挖掘与方案沟通。");
            if (k.payRate >= 100 && k.orderCount > 0) insights.push("回款率 100%，客户付款信用良好。");
            insights.push("合作天数：" + k.cooperationDays + " 天，平均客单价：¥" + toMoney(k.avgOrder));

            $("#custInsights").html(insights.map(function (t) {
                return '<li><i class="layui-icon layui-icon-tips"></i>' + t + '</li>';
            }).join(""));

            // 最近动态
            var timeline = d.timeline || [];
            if (timeline.length === 0) {
                $("#custTimeline").html('<div style="color:#9ca3af;padding:10px 0;">暂无客户动态</div>');
            } else {
                $("#custTimeline").html(timeline.map(function (t) {
                    return '<div class="item">' +
                        '<div class="t-title" style="color:' + (t.color || '#0ea5e9') + ';">' + t.type + ' · ' + t.title + '</div>' +
                        '<div class="t-desc">' + (t.desc || '') + '</div>' +
                        '<div class="t-time">' + t.time + '</div>' +
                        '</div>';
                }).join(""));
            }

            if (!analysisResizeBound) {
                analysisResizeBound = true;
                window.addEventListener("resize", function () {
                    ["custHealthChart", "custTrendChart", "custPayTypeChart", "custProductChart"].forEach(function (chartId) {
                        var dom = document.getElementById(chartId);
                        if (!dom) return;
                        var chart = echarts.getInstanceByDom(dom);
                        if (chart) chart.resize();
                    });
                });
            }
        }

        function create_receive() {
            if ($("#table_receive").length == 0) {
                $(".layui-show").append("<div id='table_receive' lay-filter='table_receive_Filter'></div>");
            }

            layer.load(2);
            table.render({
                elem: '#table_receive',
                url: '/FinanceReceive/Grid?customer_id=' + getparastr("id"),
                id: 'table_receive',
                page: true,
                defaultToolbar: ['filter'],
                cols: [[
                    { type: 'numbers', fixed: 'left', title: '序号' },
                    { field: 'Receive_num', width: 200, title: '收款单号' },
                    {
                        field: 'Order', width: 210, title: '订单号', templet: function (t) {
                            return t.Order ? t.Order.sn : "";
                        }
                    },
                    {
                        field: 'Receive_date', width: 120, title: '收款日期', templet: function (t) {
                            return t.Receive_date ? t.Receive_date.split(' ')[0] : "";
                        }
                    },
                    {
                        field: 'Receive_amount', width: 130, title: '收款金额', align: 'right', templet: function (t) {
                            return '<span style="color:#16a34a;font-weight:600;">¥' + toMoney(t.Receive_amount) + '</span>';
                        }
                    },
                    {
                        field: 'PayType', width: 120, title: '收款方式', templet: function (t) {
                            return t.PayType ? t.PayType.params_name : "";
                        }
                    },
                    {
                        field: 'Payee', width: 120, title: '收款人', templet: function (t) {
                            return t.Payee ? t.Payee.name : "";
                        }
                    },
                    { field: 'Remarks', minWidth: 180, title: '备注' }
                ]],
                limits: [10, 15, 20, 50, 100],
                limit: 15,
                done: function () {
                    layer.closeAll('loading');
                }
            });
        }

        f_reload = function (id) {
            table.reload(id, {
                page: {
                    curr: 1 //重新从第 1 页开始
                }
                , where: {
                    key: {

                    }
                }
            }, 'data');
        }

    });
</script>