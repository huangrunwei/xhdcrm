@model XHD.Core.View.Models.FinanceReportModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "财务报表";
    var jsonSettings = new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml };
    var trendJson = JsonConvert.SerializeObject(Model.Trend.Select(a => new { month = a.Month, received = a.Count, invoiced = a.Amount }), jsonSettings);
    var payTypeJson = JsonConvert.SerializeObject(Model.PayTypes.Select(a => new { name = a.Name, value = a.Value }), jsonSettings);
    var invoiceTypeJson = JsonConvert.SerializeObject(Model.InvoiceTypes.Select(a => new { name = a.Name, value = a.Value }), jsonSettings);
    var agingJson = JsonConvert.SerializeObject(Model.Aging.Select(a => new { name = a.Name, value = a.Value }), jsonSettings);
}

<link rel="stylesheet" href="~/css/report.css" />

<div class="report-page">
    <div class="report-hero">
        <div class="report-hero-main">
            <div class="report-eyebrow"><i class="fa fa-rmb"></i> FINANCE OVERVIEW</div>
            <h1>财务报表</h1>
            <p>跟踪回款、开票、应收余额和收款计划，及时识别逾期风险与资金缺口。</p>
            <div class="report-hero-tags">
                <span>@Model.Year 年度</span>
                <span>@Model.EmpName</span>
                <span>数据按当前权限范围统计</span>
            </div>
        </div>
        <form class="report-filter" method="get" action="">
            <div class="report-field">
                <label>统计年度</label>
                <select name="year" class="report-select">
                    @foreach (var y in Model.Years)
                    {
                        <option value="@y.Value" selected="@(y.Selected ? "selected" : null)">@y.Text</option>
                    }
                </select>
            </div>
            <div class="report-field">
                <label>负责员工</label>
                <select name="emp_id" class="report-select">
                    @foreach (var e in Model.Employees)
                    {
                        <option value="@e.Value" selected="@(e.Selected ? "selected" : null)">@e.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="report-btn"><i class="fa fa-filter"></i> 应用筛选</button>
            <a class="report-btn ghost" href="?"><i class="fa fa-refresh"></i> 重置</a>
            <button type="button" class="report-btn ghost" onclick="window.print()"><i class="fa fa-print"></i> 打印</button>
        </form>
    </div>

    <div class="report-kpi-grid">
        @foreach (var kpi in Model.Kpis)
        {
            <div class="report-kpi tone-@kpi.Tone">
                <div class="report-kpi-top">
                    <span>@kpi.Label</span>
                    <i class="fa @kpi.Icon"></i>
                </div>
                <div class="report-kpi-value">@kpi.Value</div>
                <div class="report-kpi-hint">@kpi.Hint</div>
            </div>
        }
    </div>

    <div class="report-grid">
        <section class="report-panel span-8">
            <div class="report-panel-head">
                <h2 class="report-panel-title">回款与开票趋势<small>@Model.Year 年按月统计回款金额与开票金额</small></h2>
                <a class="report-link" href="/FinanceReceive/Index">收款管理 <i class="fa fa-angle-right"></i></a>
            </div>
            <div id="financeTrend" class="report-chart chart-lg"></div>
        </section>

        <section class="report-panel span-4">
            <div class="report-panel-head">
                <h2 class="report-panel-title">待收款账龄<small>按计划日期统计未收款金额</small></h2>
            </div>
            @if (Model.Aging.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-calendar"></i>暂无待收计划</div>
            }
            else
            {
                <div id="agingChart" class="report-chart chart-lg"></div>
            }
        </section>
    </div>

    <div class="report-grid">
        <section class="report-panel span-4">
            <div class="report-panel-head">
                <h2 class="report-panel-title">回款方式<small>@Model.Year 年收款金额构成</small></h2>
            </div>
            @if (Model.PayTypes.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-pie-chart"></i>暂无回款数据</div>
            }
            else
            {
                <div id="payTypeChart" class="report-chart chart-sm"></div>
            }
        </section>

        <section class="report-panel span-4">
            <div class="report-panel-head">
                <h2 class="report-panel-title">发票类别<small>@Model.Year 年开票金额构成</small></h2>
            </div>
            @if (Model.InvoiceTypes.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-file-text-o"></i>暂无开票数据</div>
            }
            else
            {
                <div id="invoiceTypeChart" class="report-chart chart-sm"></div>
            }
        </section>

        <section class="report-panel span-4">
            <div class="report-panel-head">
                <h2 class="report-panel-title">回款客户排行<small>@Model.Year 年回款金额 Top 6</small></h2>
            </div>
            @if (Model.TopCustomers.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-users"></i>暂无客户回款数据</div>
            }
            else
            {
                <div class="rank-list">
                    @for (var i = 0; i < Model.TopCustomers.Count; i++)
                    {
                        var c = Model.TopCustomers[i];
                        <div class="rank-item">
                            <span class="rank-no">@(i + 1)</span>
                            <div class="rank-main">
                                <div class="rank-name">@c.Name</div>
                                <div class="rank-extra">@c.Owner · @c.OrderCount 笔</div>
                            </div>
                            <div class="rank-value">¥@c.OrderAmount.ToString("N2")</div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <div class="report-grid">
        <section class="report-panel span-7">
            <div class="report-panel-head">
                <h2 class="report-panel-title">最近收款<small>@Model.Year 年最新收款记录</small></h2>
                <a class="report-link" href="/FinanceReceive/Index">查看全部 <i class="fa fa-angle-right"></i></a>
            </div>
            @if (Model.RecentReceives.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-rmb"></i>当前年度暂无收款记录</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>收款单号</th>
                                <th>客户</th>
                                <th>订单</th>
                                <th>金额</th>
                                <th>方式</th>
                                <th>日期</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentReceives)
                            {
                                <tr>
                                    <td class="cell-name">@r.Num</td>
                                    <td class="cell-name">@r.Customer</td>
                                    <td class="cell-muted">@r.OrderSn</td>
                                    <td class="cell-money">¥@r.Amount.ToString("N2")</td>
                                    <td>@r.PayType</td>
                                    <td class="cell-muted">@(r.Date?.ToString("yyyy-MM-dd") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="report-panel span-5">
            <div class="report-panel-head">
                <h2 class="report-panel-title">待收款计划<small>按计划日期排序，优先处理逾期</small></h2>
            </div>
            @if (Model.PendingPlans.Count == 0)
            {
                <div class="report-empty"><i class="fa fa-check-circle-o"></i>暂无待收款计划</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>计划</th>
                                <th>客户</th>
                                <th>金额</th>
                                <th>日期</th>
                                <th>状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PendingPlans)
                            {
                                <tr>
                                    <td>
                                        <a class="report-link" href="/SaleOrderPayPlan/Receipt?id=@p.Id" style="font-weight:600;">@p.PlanName</a>
                                        <div class="cell-muted" style="margin-top:2px;">@p.OrderSn</div>
                                    </td>
                                    <td class="cell-name">@p.Customer</td>
                                    <td class="cell-money">¥@p.Amount.ToString("N2")</td>
                                    <td class="cell-muted">@(p.PlanDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td><span class="pill @p.TagClass">@p.Tag</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="report-footnote">小黄豆 CRM · 财务报表 · 数据实时统计</div>
</div>

<script type="text/javascript" src="/js/home/echarts.min.js"></script>
<script>
    (function () {
        var trendData = @Html.Raw(trendJson);
        var payTypeData = @Html.Raw(payTypeJson);
        var invoiceTypeData = @Html.Raw(invoiceTypeJson);
        var agingData = @Html.Raw(agingJson);
        var charts = [];
        var palette = ['#16a34a', '#2563eb', '#f59e0b', '#7c3aed', '#0891b2', '#ef4444', '#64748b', '#0ea5e9'];

        function init(id, option) {
            var dom = document.getElementById(id);
            if (!dom || typeof echarts === 'undefined') return;
            var chart = echarts.init(dom);
            chart.setOption(option);
            charts.push(chart);
        }

        function money(v) {
            var n = Number(v) || 0;
            return n >= 10000 ? (n / 10000).toFixed(1) + '万' : n.toFixed(0);
        }

        function donut(id, data, name, unit) {
            if (!data || !data.length) return;
            init(id, {
                color: palette,
                tooltip: { trigger: 'item', formatter: '{b}<br/>¥{c}（{d}%）' },
                legend: { bottom: 0, type: 'scroll', icon: 'circle', itemWidth: 8, itemHeight: 8, textStyle: { color: '#64748b', fontSize: 11 } },
                series: [{
                    name: name,
                    type: 'pie',
                    radius: ['44%', '68%'],
                    center: ['50%', '43%'],
                    itemStyle: { borderColor: '#fff', borderWidth: 3, borderRadius: 6 },
                    label: { show: false },
                    data: data
                }]
            });
        }

        if (document.getElementById('financeTrend')) {
            init('financeTrend', {
                color: ['#16a34a', '#2563eb'],
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, valueFormatter: function (v) { return '¥' + Number(v).toLocaleString(); } },
                legend: { top: 0, right: 0, icon: 'roundRect', itemWidth: 11, itemHeight: 11, textStyle: { color: '#64748b', fontSize: 11 } },
                grid: { left: 52, right: 24, top: 38, bottom: 26 },
                xAxis: { type: 'category', data: trendData.map(function (x) { return x.month; }), axisTick: { show: false }, axisLine: { lineStyle: { color: '#e5e7eb' } }, axisLabel: { color: '#9aa5b5', fontSize: 11 } },
                yAxis: { type: 'value', splitLine: { lineStyle: { color: '#f1f5f9' } }, axisLabel: { color: '#9aa5b5', fontSize: 10, formatter: money } },
                series: [
                    { name: '回款金额', type: 'bar', barWidth: 18, data: trendData.map(function (x) { return x.received; }), itemStyle: { borderRadius: [5, 5, 0, 0], color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: '#16a34a' }, { offset: 1, color: '#bbf7d0' }]) } },
                    { name: '开票金额', type: 'line', smooth: true, symbol: 'circle', symbolSize: 6, data: trendData.map(function (x) { return x.invoiced; }), lineStyle: { width: 2.5, color: '#2563eb' }, itemStyle: { color: '#2563eb', borderColor: '#fff', borderWidth: 2 }, areaStyle: { color: 'rgba(37,99,235,.08)' } }
                ]
            });
        }

        if (agingData.length) {
            var names = agingData.map(function (x) { return x.name; }).reverse();
            var values = agingData.map(function (x) { return x.value; }).reverse();
            init('agingChart', {
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' }, valueFormatter: function (v) { return '¥' + Number(v).toLocaleString(); } },
                grid: { left: 66, right: 18, top: 8, bottom: 8 },
                xAxis: { type: 'value', splitLine: { lineStyle: { color: '#f1f5f9' } }, axisLabel: { color: '#9aa5b5', fontSize: 10, formatter: money } },
                yAxis: { type: 'category', data: names, axisTick: { show: false }, axisLine: { show: false }, axisLabel: { color: '#64748b', fontSize: 11 } },
                series: [{
                    type: 'bar',
                    data: values,
                    barWidth: 15,
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0],
                        color: function (p) {
                            return ['#16a34a', '#0891b2', '#f59e0b', '#ef4444'][p.dataIndex] || '#2563eb';
                        }
                    }
                }]
            });
        }

        donut('payTypeChart', payTypeData, '回款方式', '元');
        donut('invoiceTypeChart', invoiceTypeData, '发票类别', '元');

        window.addEventListener('resize', function () {
            charts.forEach(function (c) { c.resize(); });
        });
    })();
</script>
