
@{
    ViewData["Title"] = "MenuAdd";
}

<style type="text/css">
    .downpanel .layui-select-title span { line-height: 38px; }

    /*继承父类颜色*/
    .downpanel dl dd:hover { background-color: inherit; }
</style>

@Html.Hidden("T_parent_id")


<div class="layui-form layui-form-pane" action="">
    <div class="layui-card">
        <div class="layui-card-header">目录</div>
        <div class="layui-card-body">
            @Html.Hidden("Btn_IdList")
            <div class="layui-form-item">
                <label class="layui-form-label required">菜单ID</label>
                <div class="layui-input-inline">
                    <input type="text" name="id" id="id" autocomplete="off" placeholder="请输入菜单ID" lay-verify="required|userName" class="layui-input ">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label required">菜单名称</label>
                <div class="layui-input-inline">
                    <input type="text" name="Menu_name" id="Menu_name" autocomplete="off" placeholder="请输入菜单名称" class="layui-input" lay-verify="required">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label required">上级菜单</label>
                <div class="layui-input-inline">
                    <div class="layui-unselect layui-form-select downpanel">
                        <div class="layui-select-title">
                            <span class="layui-input layui-unselect" id="treeclass">选择上级菜单</span>
                            <input type="hidden" name="parentid" id="parentid" value="root" lay-verify="required">
                            <i class="layui-edge"></i>
                        </div>
                        <dl class="layui-anim layui-anim-upbit">
                            <dd>
                                <ul id="classtree"></ul>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label required">菜单图标</label>
                <div class="layui-input-block">
                    <input type="text" id="Menu_icon" name="Menu_icon" lay-filter="iconPicker" class="hide" lay-verify="required">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label required">菜单排序</label>
                <div class="layui-input-inline">
                    <input type="number" name="Menu_order" id="Menu_order" autocomplete="off" placeholder="请输入菜单排序" class="layui-input" lay-verify="required">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">菜单目录</label>
                <div class="layui-input-block">
                    <input type="text" name="Menu_url" id="Menu_url" autocomplete="off" placeholder="请输入菜单URL" class="layui-input">
                </div>
            </div>
            <div class="layui-form-item">
                <label class="layui-form-label">按钮</label>
                <div class="layui-input-block">
                    <input type="checkbox" name="btn_add" id="btn_add" title="新增">
                    <input type="checkbox" name="btn_edit" id="btn_edit" title="修改">
                    <input type="checkbox" name="btn_del" id="btn_del" title="删除">
                    <input type="checkbox" name="btn_import" id="btn_import" title="导入">
                    <input type="checkbox" name="btn_export" id="btn_export" title="导出">
                    <input type="checkbox" name="btn_auth" id="btn_auth" title="权限">
                    <input type="checkbox" name="btn_pwd" id="btn_pwd" title="修改密码">
                    @*<input type="checkbox" name="btn[recharge]" title="充值">*@
                </div>
            </div>

        </div>
    </div>


    <div class="layui-form-item layui-hide">
        <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
    </div>
</div>
<script>
    var id = null;
    layui.use(['iconPickerFa', 'tree', 'form', 'layer', 'tableSelect'], function () {
        var iconPickerFa = layui.iconPickerFa,
            tree = layui.tree,
            form = layui.form,
            layer = layui.layer,
            $ = layui.$;
        var tableSelect = layui.tableSelect;


        iconPickerFa.render({
            // 选择器，推荐使用input
            elem: '#Menu_icon',
            // fa 图标接口
            url: "/layuimini/lib/font-awesome-4.7.0/less/variables.less",
            // 是否开启搜索：true/false，默认true
            search: true,
            // 是否开启分页：true/false，默认true
            page: true,
            // 每页显示数量，默认12
            limit: 16,
            // 点击回调
            click: function (data) {
                console.log(data);
            },
            // 渲染成功后的回调
            success: function (d) {
                console.log(d);
            }
        });

        $.ajax({
            type: 'POST',
            url: 'tree',
            data: {
                id: $("#id").val(), //主键
            },
            dataType: "json",
            success: function (res) {//res为相应体,function为回调函数
                tree.render({
                    elem: "#classtree",
                    data: res,
                    //showLine: false,
                    click: function (node) {
                        console.log(node);
                        var $select = $($(this)[0].elem).parents(".layui-form-select");
                        $select.removeClass("layui-form-selected").find(".layui-select-title span").html(node.data.title).end().find("input:hidden[name='parentid']").val(node.data.id);
                    }
                });
                $(".downpanel").on("click", ".layui-select-title", function (e) {
                    $(".layui-form-select").not($(this).parents(".layui-form-select")).removeClass("layui-form-selected");
                    $(this).parents(".downpanel").toggleClass("layui-form-selected");
                    layui.stope(e);
                }).on("click", "dl i", function (e) {
                    layui.stope(e);
                });
                $(document).on("click", function (e) {
                    $(".layui-form-select").removeClass("layui-form-selected");
                });

                var data = findPathByLeafId($("#parentid").val(), res);
                $("#treeclass").text(data);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
            }
        });

        tableSelect.render({
            elem: '#Btn_List',
            checkedKey: 'Btn_id',
            table: {
                url: '/SysButton/Grid',
                cols: [[
                    { type: 'checkbox' },
                    { field: 'Btn_name', title: '按钮名', width: 120 }
                ]]
            },
            done: function (elem, data) {
                var NEWJSON = [];
                var ids = [];

                console.log(data.data);

                layui.each(data.data, function (index, item) {
                    NEWJSON.push(item.Btn_name)
                    ids.push(item.Btn_id);
                })
                elem.val(NEWJSON.join(","))

                $("#Btn_IdList").val(ids.join(','));

            }
        })

        if (id) {
            $("#Menu_id").addClass("layui-disabled");
        }


        function child(res, index) {
            id = res.id;
        }


        function findPathByLeafId(leafId, nodes, path) {

            if (path === undefined) {
                path = [];
            }
            for (var i = 0; i < nodes.length; i++) {
                var tmpPath = path.concat();
                tmpPath.push(nodes[i].id);
                if (leafId == nodes[i].id) {
                    return nodes[i].title;
                }
                if (nodes[i].children) {
                    var findResult = findPathByLeafId(leafId, nodes[i].children, tmpPath);
                    if (findResult) {
                        return findResult;
                    }
                }
            }
        }

    });


</script>
