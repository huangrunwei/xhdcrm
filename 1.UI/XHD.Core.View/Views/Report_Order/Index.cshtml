@{
    ViewData["Title"] = "Index";
}




<div class="layuimini-main">

    <div class="layui-row layui-col-space15">
        <form class="layui-form layui-form-pane" action="">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">员工</label>
                    <div class="layui-input-inline">
                        <input type="text" id="employee" autocomplete="off" class="layui-input" lay-verify="required">
                        <input type="text" name="emp_id" id="emp_id" style="display:none;">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">年度</label>
                    <div class="layui-input-inline">
                        <input type="text" name="year" id="year" autocomplete="off" class="layui-input" lay-verify="required">
                    </div>
                </div>

                <div class="layui-inline">
                    <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn" id="btn_serch"><i class="layui-icon"></i> 搜 索</button>
                    <button type="reset" class="layui-btn layui-btn-primary" id="btn_reset"><i class="layui-icon"></i> 重置</button>
                </div>
            </div>
        </form>
    </div>
    <div class="layui-row layui-col-space15">
        <div class="layui-col-xs12 layui-col-md6">
            <div id="echarts-year" style="background-color:#ffffff;min-height:300px;padding: 10px"></div>
        </div>
        <div class="layui-col-xs12 layui-col-md6">
            <div id="echarts-sum" style="background-color:#ffffff;min-height:300px;padding: 10px"></div>
        </div>
    </div>
    <div class="layui-row layui-col-space15">
        <div class="layui-col-xs12 layui-col-md6">
            <div id="echarts-status" style="background-color:#ffffff;min-height:300px;padding: 10px"></div>
        </div>
        <div class="layui-col-xs12 layui-col-md6">
            <div id="echarts-pay" style="background-color:#ffffff;min-height:300px;padding: 10px"></div>
        </div>
    </div>
</div>
<script type="text/javascript" src="/js/home/echarts.min.js"></script>
<script>
    layui.use(['table', 'treetable','form', 'tableSelect', 'laydate'], function () {
        var $ = layui.jquery;
        var table = layui.table;
        var treetable = layui.treetable;
        var form=layui.form;
        var tableSelect = layui.tableSelect;
        var laydate = layui.laydate;


        //日期
        laydate.render({
            elem: '#year'
            ,type: 'year'
        });


        tableSelect.render({
            elem: '#employee',
            checkedKey: 'id',
            table: {
                url: '/HrEmployee/grid',
                cols: [[
                    { type: 'checkbox' },
                    { field: 'name', width: 150, title: '员工姓名' },
                    { field: 'dep_name', width: 150, title: '部门' ,templet:function(t){
                        if(t.department)
                        {
                            return t.department.dep_name;
                        }
                        return "";
                    }},
                    { field: 'position_name', width: 150, title: '职务' ,templet:function(t){
                        if(t.position)
                        {
                            return t.position.position_name;
                        }
                        return "";
                    }},
                    ]],
                    limit: 100
            },
            done: function (elem, data) {
                var NEWJSON = [];
                var ids = [];

                layui.each(data.data, function (index, item) {
                    NEWJSON.push(item.name);
                    ids.push(item.id);
                })
                elem.val(NEWJSON.join(","))

                $("#emp_id").val(ids.join(','));


            }
        })

        // 监听搜索操作
        form.on('submit(data-search-btn)', function (data) {
            $.ajax({
                url: "ReportYear",
                data:data.field,
                type: "gt",
                dataType: "json",
                success: function (data) {
                    echarts_1(data);
                },
            });

            $.ajax({
                url: "ReportYearSum",
                data:data.field,
                type: "get",
                dataType: "json",
                success: function (data) {
                    echarts_2(data);
                },
            });

            $.ajax({
                url: "ReportStatus",
                data:data.field,
                type: "get",
                dataType: "json",
                success: function (data) {
                    echarts_3(data);
                },
            });

            $.ajax({
                url: "ReportPayType",
                data:data.field,
                type: "get",
                dataType: "json",
                success: function (data) {
                    echarts_4(data);
                },
            });

            return false;
        });

        function echarts_1(data) {

            var seriesdata=[];
            for(var i=0;i<data.length;i++)
            {
                seriesdata.push(data[i].count);
            }

            // 基于准备好的dom，初始化echarts实例
            var myChart = echarts.init(document.getElementById('echarts-year'));
            option = {
                title:{
                    text:"订单年度统计图"
                },
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'shadow'
                    }
                },
                xAxis: {
                    type: 'category',
                    data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        data: seriesdata,
                        type: 'bar',
                        showBackground: true,
                        backgroundStyle: {
                            color: 'rgba(180, 180, 180, 0.2)'
                        },
                        itemStyle:{
                            normal:{
                                        color: function(params) {
                                // build a color map as your need.
                                var colorList = [
                                    '#C1232B','#B5C334','#FCCE10','#E87C25','#27727B',
                                    '#FE8463','#9BCA63','#FAD860','#F3A43B','#60C0DD',
                                    '#D7504B','#C6E579','#F4E001','#F0805A','#26C0C0'
                                ];
                                return colorList[params.dataIndex]
                                }
                            }
                        }
                    }
                ]
            };
            // 使用刚指定的配置项和数据显示图表。
            myChart.setOption(option);
            window.addEventListener("resize", function () {
                myChart.resize();
            });
        }

        function echarts_2(data) {

            var seriesdata=[];
            for(var i=0;i<data.length;i++)
            {
                seriesdata.push(data[i].count);
            }

            // 基于准备好的dom，初始化echarts实例
            var myChart = echarts.init(document.getElementById('echarts-sum'));
            option = {
                title:{
                    text:"订单金额年度统计图"
                },
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'shadow'
                    }
                },
                xAxis: {
                    type: 'category',
                    data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '1月', '12月']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        data: seriesdata,
                        type: 'bar',
                        showBackground: true,
                        backgroundStyle: {
                            color: 'rgba(180, 180, 180, 0.2)'
                        },
                        itemStyle:{
                            normal:{
                                        color: function(params) {
                                // build a color map as your need.
                                var colorList = [
                                    '#C1232B','#B5C334','#FCCE10','#E87C25','#27727B',
                                    '#FE8463','#9BCA63','#FAD860','#F3A43B','#60C0DD',
                                    '#D7504B','#C6E579','#F4E001','#F0805A','#26C0C0'
                                ];
                                return colorList[params.dataIndex]
                                }
                            }
                        }
                    }
                ]
            };
            // 使用刚指定的配置项和数据显示图表。
            myChart.setOption(option);
            window.addEventListener("resize", function () {
                myChart.resize();
            });
        }

        function echarts_3(data) {

            // 基于准备好的dom，初始化echarts实例
            var myChart = echarts.init(document.getElementById('echarts-status'));
                option = {
                        color: ['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de', '#3ba272', '#fc8452', '#9a60b4', '#ea7ccc'],  // 添加这一行
                    title: {
                        text: '订单状态分析',
                        subtext: $("#year").val()+'年度',
                        left: 'center'
                    },
                    tooltip: {
                        trigger: 'item'
                    },
                    legend: {
                        orient: 'vertical',
                        left: 'right'
                    },
                    series: [
                        {
                            name: '订单状态',
                            type: 'pie',
                            radius: ['30%', '70%'],
                            itemStyle: {
                                borderRadius: 10,
                                borderColor: '#fff',
                                borderWidth: 2
                            },
                            data: data,
                            emphasis: {
                                itemStyle: {
                                    shadowBlur: 10,
                                    shadowOffsetX: 0,
                                    shadowColor: 'rgba(0, 0, 0, 0.5)'
                                }
                            }
                        }
                    ]
                };

                // 使用刚指定的配置项和数据显示图表。
                myChart.setOption(option);
                window.addEventListener("resize", function () {
                    myChart.resize();
                });
            }
        function echarts_4(data) {

            // 基于准备好的dom，初始化echarts实例
            var myChart = echarts.init(document.getElementById('echarts-pay'));
                option = {
                        color: ['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de', '#3ba272', '#fc8452', '#9a60b4', '#ea7ccc'],  // 添加这一行
                    title: {
                        text: '支付方式分析',
                        subtext: $("#year").val()+'年度',
                        left: 'center'
                    },
                    tooltip: {
                        trigger: 'item'
                    },
                    legend: {
                        orient: 'vertical',
                        left: 'right'
                    },
                    series: [
                        {
                            name: '支付方式',
                            type: 'pie',
                            radius: ['30%', '70%'],
                            itemStyle: {
                                borderRadius: 10,
                                borderColor: '#fff',
                                borderWidth: 2
                            },
                            data: data,
                            emphasis: {
                                itemStyle: {
                                    shadowBlur: 10,
                                    shadowOffsetX: 0,
                                    shadowColor: 'rgba(0, 0, 0, 0.5)'
                                }
                            }
                        }
                    ]
                };

                // 使用刚指定的配置项和数据显示图表。
                myChart.setOption(option);
                window.addEventListener("resize", function () {
                    myChart.resize();
                });
        }
    });
</script>
