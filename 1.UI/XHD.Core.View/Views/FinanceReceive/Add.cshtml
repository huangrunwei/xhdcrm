@{
    ViewData["Title"] = "MenuAdd";
}

<style type="text/css">
    .downpanel .layui-select-title span { line-height: 38px; }

    /*继承父类颜色*/
    .downpanel dl dd:hover { background-color: inherit; }
</style>

<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")
    @Html.Hidden("order_id")
    @Html.Hidden("Pay_type_val")
    @Html.Hidden("Payee_id")
    <div class="layui-card">
        <div class="layui-card-header">收款</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label required">订单号码</label>
                    <div class="layui-input-inline">
                        <input type="text" name="order" id="order" autocomplete="off" placeholder="订单号码" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">收款单号</label>
                    <div class="layui-input-inline">
                        <input type="text" name="Receive_num" id="Receive_num" autocomplete="off" placeholder="收款单号" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">支付类别</label>
                    <div class="layui-input-inline">
                        <select id="Pay_type_id" name="Pay_type_id" autocomplete="off" class="layui-input" lay-verify="required">
                            <option value=""></option>
                        </select>
                    </div>
                </div>

                <div class="layui-inline">

                    <label class="layui-form-label required">收款金额</label>
                    <div class="layui-input-inline">
                        <input type="number" name="Receive_amount" id="Receive_amount" autocomplete="off" placeholder="收款金额" class="layui-input" lay-verify="required">
                    </div>
                </div>
                @*<div class="layui-inline">
                        <label class="layui-form-label required">发票内容</label>
                        <div class="layui-input-inline">
                            <input type="text" name="invoice_content" id="invoice_content" autocomplete="off" placeholder="发票内容" class="layui-input" lay-verify="required">
                        </div>
                    </div>*@
                <div class="layui-inline">
                    <label class="layui-form-label required">收款人</label>
                    <div class="layui-input-inline">
                        <input type="text" name="Payeer" id="Payeer" autocomplete="off" placeholder="收款人" class="layui-input" lay-verify="required">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">收款日期</label>
                    <div class="layui-input-inline">
                        <input type="text" name="Receive_date" id="Receive_date" autocomplete="off" placeholder="收款日期" class="layui-input" lay-verify="required">
                    </div>
                </div>
            </div>
            <div class="layui-form-item layui-form-text">
                <div class="layui-input-block">
                    <textarea id="Remarks" name="Remarks" placeholder="请输入备注" class="layui-textarea"></textarea>
                </div>
            </div>
            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>
        </div>
    </div>
    <script>
        var id = null;
        layui.use(['tree', 'form', 'layer', 'tableSelect', 'table', 'laydate'], function () {
            var form = layui.form,
                tree = layui.tree,
                layer = layui.layer,
                $ = layui.$;
            var table = layui.table;
            var laydate = layui.laydate;
            var numberInput = layui.numberInput;
            var tableSelect = layui.tableSelect;

            laydate.render({
                elem: '#Receive_date' //指定元素
                , trigger: 'click'
            });

            //下拉
            $.ajax({
                url: "/SysParam/Combo",
                data: { type: 'pay_type' },
                type: "post",
                dataType: "json",
                success: function (data) {
                    var data = data.data;
                    var category = $('#Pay_type_id');
                    category.html("");
                    category.append('<option value="">请选择</option>');
                    for (var i = 0; i < data.length; i++) {

                        console.log(data[i]);
                        category.append("<option value='" + data[i]["id"] + "'>" + data[i]["params_name"] + "</option>");
                    }
                    if ($("#Pay_type_val").val()) {
                        setTimeout(function () {
                            var select = 'dd[lay-value=' + $("#Pay_type_val").val() + ']';
                            $(category).siblings("div.layui-form-select").find('dl').find(select).click();
                            $("#data-search-btn").click();
                        }, 50)
                    }

                    form.render("select");
                },
            });

            tableSelect.render({
                elem: '#order',
                checkedKey: 'id',
                table: {
                    url: '/SaleOrder/grid',
                    width: 500,
                    cols: [[
                        { type: 'radio' },
                        {
                            field: 'cus_name', width: 250, title: '客户', templet: function (t) {
                                if (t.customer) {
                                    return t.customer.cus_name;
                                }
                                return "";
                            }
                        },
                        { field: 'sn', width: 220, title: '订单号' },
                        {
                            field: 'Order_date', width: 120, title: '订单时间', templet: function (item) {
                                var value = item.Order_date;
                                if (isNaN(value) && !isNaN(Date.parse(value))) {
                                    value = value.replace(' 00:00:00', '');
                                }
                                return value;
                            }
                        },
                        {
                            field: 'Order_status_id', width: 120, title: '订单状态', templet: function (item) {
                                if (item.PayType) {
                                    return item.OrderStatus.params_name;
                                }
                            }
                        },
                        {
                            field: 'pay_type_id', width: 120, title: '支付类别', templet: function (item) {
                                if (item.PayType) {
                                    return item.PayType.params_name;
                                }
                            }
                        },
                        { field: 'Order_amount', width: 100, title: '订单金额', align: 'right' },

                    ]]
                },
                done: function (elem, data) {
                    var NEWJSON = [];
                    var ids = [];

                    layui.each(data.data, function (index, item) {
                        NEWJSON.push(item.sn);
                        ids.push(item.id);
                    })
                    elem.val(NEWJSON.join(","))

                    $("#order_id").val(ids.join(','));


                }
            })

            tableSelect.render({
                elem: '#Payeer',
                checkedKey: 'id',
                table: {
                    url: '/HrEmployee/grid',
                    cols: [[
                        { type: 'radio' },
                        { field: 'name', width: 150, title: '员工姓名' },
                        {
                            field: 'dep_name', width: 150, title: '部门', templet: function (t) {
                                if (t.department) {
                                    return t.department.dep_name;
                                }
                                return "";
                            }
                        },
                        {
                            field: 'position_name', width: 150, title: '职务', templet: function (t) {
                                if (t.position) {
                                    return t.position.position_name;
                                }
                                return "";
                            }
                        },
                    ]]
                },
                done: function (elem, data) {
                    var NEWJSON = [];
                    var ids = [];

                    layui.each(data.data, function (index, item) {
                        NEWJSON.push(item.name);
                        ids.push(item.id);
                    })
                    elem.val(NEWJSON.join(","))

                    $("#Payee_id").val(ids.join(','));


                }
            })

        });


    </script>
