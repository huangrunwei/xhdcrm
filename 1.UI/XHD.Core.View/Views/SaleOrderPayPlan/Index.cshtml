@{
    ViewData["Title"] = "收款计划";
}

<style>
    .plan-stats { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; }
    .plan-stat { flex: 1 1 180px; background: #fff; border-radius: 8px; padding: 16px 18px; box-shadow: 0 1px 4px rgba(0,0,0,.06); border-left: 4px solid #1677ff; }
    .plan-stat .label { color: #6b7280; font-size: 13px; }
    .plan-stat .value { font-size: 24px; font-weight: 700; color: #111827; margin-top: 6px; }
    .plan-stat.green { border-left-color: #16a34a; }
    .plan-stat.orange { border-left-color: #f59e0b; }
    .plan-stat.red { border-left-color: #ef4444; }
    .plan-sub { color: #9ca3af; font-size: 12px; margin-top: 4px; }
    .money { font-variant-numeric: tabular-nums; }
</style>

<div class="table-search-fieldset">
    <div>
        <form class="layui-form layui-form-pane" action="">
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">关键字</label>
                <div class="layui-input-inline">
                    <input type="text" name="keyword" id="keyword" placeholder="客户/订单号/计划名称" autocomplete="off" class="layui-input">
                </div>
            </div>
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">状态</label>
                <div class="layui-input-inline">
                    <select id="plan_status" name="plan_status">
                        <option value="">全部</option>
                        <option value="0">待收款</option>
                        <option value="1">部分收款</option>
                        <option value="2">已收清</option>
                        <option value="3">已逾期</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item layui-inline">
                <label class="layui-form-label">计划日期</label>
                <div class="layui-input-inline" style="width: 110px;">
                    <input type="text" name="date1" id="date1" placeholder="yyyy-MM-dd" autocomplete="off" class="layui-input">
                </div>
                <div class="layui-form-mid">-</div>
                <div class="layui-input-inline" style="width: 110px;">
                    <input type="text" name="date2" id="date2" placeholder="yyyy-MM-dd" autocomplete="off" class="layui-input">
                </div>
            </div>
            <div class="btn-group-inline">
                <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn" id="btn_serch"><i class="layui-icon layui-icon-search"></i> 搜索</button>
                <button type="reset" class="layui-btn layui-btn-primary" id="btn_reset"><i class="layui-icon layui-icon-error"></i> 重置</button>
            </div>
        </form>
    </div>
</div>

<div class="plan-stats">
    <div class="plan-stat">
        <div class="label">计划总额</div>
        <div class="value money" id="stat_total">0.00</div>
        <div class="plan-sub" id="stat_count">共 0 期</div>
    </div>
    <div class="plan-stat green">
        <div class="label">已收金额</div>
        <div class="value money" id="stat_received">0.00</div>
        <div class="plan-sub" id="stat_finished">已收清 0 期</div>
    </div>
    <div class="plan-stat orange">
        <div class="label">未收金额</div>
        <div class="value money" id="stat_remain">0.00</div>
        <div class="plan-sub">按计划应收余额</div>
    </div>
    <div class="plan-stat red">
        <div class="label">逾期计划</div>
        <div class="value money" id="stat_overdue">0</div>
        <div class="plan-sub">需要重点跟进</div>
    </div>
</div>

<div class="layuimini-card">
    <div class="layui-card-body">
        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add"><i class="layui-icon layui-icon-add-1"></i> 新建收款计划</button>
            </div>
        </script>
        <script type="text/html" id="auth-state">
            <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="receipt">收款单</a>
            <a class="layui-btn layui-btn-xs layui-btn-green" lay-event="receive">登记收款</a>
            <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">修改</a>
            <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
        </script>

        <table id="munu-table" class="layui-table" lay-filter="currentTableFilter"></table>
    </div>
</div>

<div id="registerForm" style="display:none; padding: 20px;">
    <form class="layui-form" lay-filter="registerForm">
        <input type="hidden" id="reg_plan_id">
        <div class="layui-form-item">
            <label class="layui-form-label">收款计划</label>
            <div class="layui-input-block">
                <input type="text" id="reg_plan_name" class="layui-input" readonly>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label required">收款金额</label>
            <div class="layui-input-block">
                <input type="number" id="reg_amount" step="0.01" class="layui-input" placeholder="0.00">
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">收款日期</label>
            <div class="layui-input-block">
                <input type="text" id="reg_date" class="layui-input" placeholder="yyyy-MM-dd">
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">收款方式</label>
            <div class="layui-input-block">
                <select id="reg_pay_type">
                    <option value="">请选择</option>
                </select>
            </div>
        </div>
        <div class="layui-form-item layui-form-text">
            <label class="layui-form-label">备注</label>
            <div class="layui-input-block">
                <textarea id="reg_remarks" class="layui-textarea" placeholder="收款说明"></textarea>
            </div>
        </div>
    </form>
</div>

<script>
    layui.use(['table', 'form', 'layer', 'laydate'], function () {
        var $ = layui.jquery;
        var table = layui.table;
        var form = layui.form;
        var layer = layui.layer;
        var laydate = layui.laydate;

        laydate.render({ elem: '#date1', trigger: 'click' });
        laydate.render({ elem: '#date2', trigger: 'click' });
        laydate.render({ elem: '#reg_date', trigger: 'click' });

        function statusBadge(status) {
            switch (status) {
                case 2: return '<span class="layui-badge layui-bg-green">已收清</span>';
                case 3: return '<span class="layui-badge">已逾期</span>';
                case 1: return '<span class="layui-badge layui-bg-orange">部分收款</span>';
                default: return '<span class="layui-badge layui-bg-blue">待收款</span>';
            }
        }

        table.render({
            elem: '#munu-table',
            url: 'Grid',
            toolbar: '#toolbarDemo',
            defaultToolbar: ['filter'],
            id: "payPlanGrid",
            cols: [[
                { type: 'numbers', width: 65, title: '序号' },
                {
                    field: 'cus_name', width: 170, title: '客户', templet: function (t) {
                        return t.Order && t.Order.customer ? t.Order.customer.cus_name : "";
                    }
                },
                {
                    field: 'sn', width: 160, title: '订单号', templet: function (t) {
                        return t.Order ? t.Order.sn : "";
                    }
                },
                {
                    field: 'plan_name', width: 150, title: '计划名称', templet: function (t) {
                        return t.plan_name || '';
                    }
                },
                {
                    field: 'plan_amount', width: 110, title: '计划金额', align: 'right', templet: function (t) {
                        return '<span class="money">' + toMoney(t.plan_amount) + '</span>';
                    }
                },
                {
                    field: 'received_amount', width: 100, title: '已收', align: 'right', templet: function (t) {
                        return '<span class="money" style="color:#16a34a;">' + toMoney(t.received_amount) + '</span>';
                    }
                },
                {
                    field: 'remain', width: 100, title: '未收', align: 'right', templet: function (t) {
                        var remain = (parseFloat(t.plan_amount) || 0) - (parseFloat(t.received_amount) || 0);
                        return '<span class="money" style="color:' + (remain > 0 ? '#ef4444' : '#16a34a') + ';">' + toMoney(remain) + '</span>';
                    }
                },
                {
                    field: 'plan_date', width: 110, title: '计划日期', templet: function (t) {
                        return t.plan_date ? t.plan_date.split(' ')[0] : "";
                    }
                },
                {
                    field: 'plan_status', width: 80, title: '状态', align: 'center', templet: function (t) {
                        return statusBadge(t.plan_status);
                    }
                },
                { templet: '#auth-state', width: 285, align: 'center', title: '操作' }
            ]],
            limits: [10, 15, 20, 25, 50, 100],
            limit: 15,
            page: true,
            done: function () {
                layer.closeAll('loading');
            }
        });

        // 操作列
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {
                openAdd('');
            }
        });

        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            if (obj.event === 'edit') {
                openAdd(data.id);
            } else if (obj.event === 'del') {
                layer.confirm('确定删除该收款计划？', { icon: 3, title: '提示' }, function (index) {
                    $.ajax({
                        url: 'Delete',
                        type: 'post',
                        data: { id: data.id },
                        dataType: 'json',
                        success: function (res) {
                            if (res.code === 0) {
                                table.reload('payPlanGrid');
                                loadSummary();
                            } else {
                                layer.msg(res.msg, { icon: 2 });
                            }
                        }
                    });
                    layer.close(index);
                });
            } else if (obj.event === 'receipt') {
                openReceipt(data.id);
            } else if (obj.event === 'receive') {
                openRegister(data);
            }
        });

        function openAdd(id) {
            var url = 'Add' + (id ? '?id=' + id : '');
            layer.open({
                title: id ? '修改收款计划' : '新建收款计划',
                type: 2,
                area: ['760px', '560px'],
                maxmin: true,
                content: url,
                btn: ['确定', '关闭'],
                yes: function (index, layero) {
                    var iframeWindow = window['layui-layer-iframe' + index];
                    var submit = layero.find('iframe').contents().find('#LAY-user-front-submit');
                    submit.trigger('click');
                },
                btn2: function (index) { layer.close(index); }
            });
        }

        function openReceipt(id) {
            layer.open({
                title: '收款单',
                type: 2,
                area: ['1080px', '85%'],
                maxmin: true,
                content: 'Receipt?id=' + id,
                btn: ['关闭'],
                yes: function (index) { layer.close(index); }
            });
        }

        function openRegister(data) {
            var remain = (parseFloat(data.plan_amount) || 0) - (parseFloat(data.received_amount) || 0);
            if (remain <= 0) remain = parseFloat(data.plan_amount) || 0;

            $('#reg_plan_id').val(data.id);
            $('#reg_plan_name').val(data.plan_name + ' / ' + (data.Order ? data.Order.sn : ''));
            $('#reg_amount').val(remain.toFixed(2));
            $('#reg_date').val(new Date().toISOString().slice(0, 10));
            $('#reg_remarks').val('');
            if (data.PayType) {
                $('#reg_pay_type').val(data.PayType.id);
            } else {
                $('#reg_pay_type').val('');
            }
            form.render('select');

            layer.open({
                title: '登记收款',
                type: 1,
                area: ['520px', '520px'],
                content: $('#registerForm'),
                btn: ['确认收款', '取消'],
                yes: function (index) {
                    var amount = parseFloat($('#reg_amount').val());
                    if (!amount || amount <= 0) {
                        layer.msg('请输入正确的收款金额', { icon: 2 });
                        return false;
                    }
                    var loading = layer.load(2);
                    $.ajax({
                        url: 'RegisterReceive',
                        type: 'post',
                        data: {
                            plan_id: $('#reg_plan_id').val(),
                            amount: amount,
                            receive_date: $('#reg_date').val(),
                            pay_type_id: $('#reg_pay_type').val(),
                            remarks: $('#reg_remarks').val()
                        },
                        dataType: 'json',
                        success: function (res) {
                            layer.close(loading);
                            if (res.code === 0) {
                                layer.close(index);
                                layer.msg('收款登记成功', { icon: 1 });
                                table.reload('payPlanGrid');
                                loadSummary();
                            } else {
                                layer.msg(res.msg, { icon: 2 });
                            }
                        },
                        error: function () {
                            layer.close(loading);
                            layer.msg('请求失败', { icon: 2 });
                        }
                    });
                    return false;
                }
            });
        }

        function loadSummary() {
            $.ajax({
                url: 'Summary',
                type: 'get',
                data: {
                    keyword: $('#keyword').val(),
                    plan_status: $('#plan_status').val(),
                    date1: $('#date1').val(),
                    date2: $('#date2').val()
                },
                dataType: 'json',
                success: function (res) {
                    var d = res.data && res.data[0];
                    if (!d) return;
                    $('#stat_total').text(toMoney(d.total));
                    $('#stat_count').text('共 ' + d.count + ' 期');
                    $('#stat_received').text(toMoney(d.received));
                    $('#stat_finished').text('已收清 ' + d.finished + ' 期');
                    $('#stat_remain').text(toMoney(d.remain));
                    $('#stat_overdue').text(d.overdue);
                }
            });
        }

        // 收款方式
        $.ajax({
            url: "/SysParam/Combo",
            data: { type: 'pay_type' },
            type: "post",
            dataType: "json",
            success: function (res) {
                var select = $('#reg_pay_type');
                select.html('<option value="">请选择</option>');
                layui.each(res.data || [], function (i, item) {
                    select.append("<option value='" + item.id + "'>" + item.params_name + "</option>");
                });
                form.render('select');
            }
        });

        form.on('submit(data-search-btn)', function (data) {
            var curr = $(".layui-laypage-skip").find("input").val() || 1;
            table.reload('payPlanGrid', { page: { curr: curr }, where: data.field }, 'data');
            loadSummary();
            return false;
        });

        $('#btn_reset').on('click', function () {
            setTimeout(function () {
                table.reload('payPlanGrid', { where: { keyword: '', plan_status: '', date1: '', date2: '' } }, 'data');
                loadSummary();
            }, 30);
        });

        loadSummary();
    });
</script>
