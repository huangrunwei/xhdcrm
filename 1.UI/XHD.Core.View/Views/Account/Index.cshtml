<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["company"]-登陆</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta http-equiv="Access-Control-Allow-Origin" content="*">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    <link rel="icon" href="~/layuimini/images/favicon.ico">
    
    <!-- 引入 Layui CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/layui@2.8.18/dist/css/layui.css">
    <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: "Microsoft Yahei", sans-serif; background: linear-gradient(160deg, #6666FF 0%, #ffffff 50%, #33CCFF 100%); min-height: 100vh; background-attachment: fixed; }

            .login-container { display: flex; align-items: center; justify-content: space-around; min-height: 100vh; padding: 0 5%; }
            .login-illustration { width: 50%; display: flex; align-items: center; justify-content: center; }
            .illustration-wrap { position: relative; width: 600px; height: 400px; background-image: url("../images/bg_img.png"); background-size: 100% auto; background-position: center; background-repeat: no-repeat; }
            .login-form-wrap { width: 320px; background: #ffffff; padding: 35px 30px; border-radius: 12px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05); border: 1px solid #ddd; }
            .login-title { text-align: center; font-size: 20px; font-weight: bold; color: #2c3e50; margin-bottom: 30px; }
            .layui-form-item { margin-bottom: 18px; position: relative; }
            .layui-input { height: 42px; border-radius: 6px; border: 1px solid #eaecef; background: #fafbfc; color: #333; padding-left: 38px; }
                .layui-input::placeholder { color: #999; }
            .input-icon { position: absolute; left: 12px; top: 14px; color: #999; }
            .captcha-wrap { display: flex; align-items: center; gap: 10px; }
                .captcha-wrap .layui-input { flex: 1; padding-right: 10px; }
            .captcha-img { width: 120px; height: 42px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
                .captcha-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
            .login-btn { width: 100%; height: 44px; background: #42a5ff; border: none; border-radius: 6px; color: #fff; font-size: 15px; cursor: pointer; transition: background 0.3s; }
                .login-btn:hover { background: #3399ff; }
            .layui-disabled, .layui-disabled:hover { background-color: #c2c2c2 !important; color: #fff !important; cursor: not-allowed !important; }
            .version { text-align: center; font-size: 12px; color: #999; margin-top: 10px; }
            .copyright { position: fixed; bottom: 15px; left: 0; right: 0; text-align: center; font-size: 12px; color: #999; }
            @@media (max-width: 900px) {
                .login-container { flex-direction: column; justify-content: center; padding: 20px; }
                .login-illustration { display: none; }
                .login-form-wrap { width: 100%; max-width: 350px; }
            }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- 左侧插画 -->
        <div class="login-illustration">
            <div class="illustration-wrap"></div>
        </div>

        <!-- 右侧登录表单 -->
        <div class="login-form-wrap">
            <div class="login-title">@ViewData["company"]</div>
            <div class="layui-form" id="loginFormContainer">
                <div class="layui-form-item">
                    <i class="layui-icon layui-icon-username input-icon"></i>
                    <input type="text" name="uid" id="uid" lay-verify="required|account" placeholder="用户名" autocomplete="off" class="layui-input" value="admin">
                </div>
                <div class="layui-form-item">
                    <i class="layui-icon layui-icon-password input-icon"></i>
                    <input type="password" name="pwd" id="pwd" lay-verify="required|password" placeholder="密码" autocomplete="off" class="layui-input" value="">
                </div>
                <div class="layui-form-item">
                    <div class="captcha-wrap">
                        <div style="position: relative;flex:1">
                            <i class="layui-icon layui-icon-vercode input-icon"></i>
                            <input type="text" name="valicode" id="valicode" lay-verify="required|captcha" placeholder="图形验证码" autocomplete="off" class="layui-input">
                        </div>
                        <div class="captcha-img">
                            <img id="captchaPic" src="~/Account/ValiCode" onclick="refreshCaptcha(this)" alt="验证码">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <button class="login-btn" id="btn_login">登 入</button>
                </div>
                <div class="version">Ver 3.1</div>
            </div>
        </div>
    </div>

    <div class="copyright">Power by www.xhdcrm.com</div>

    <!-- JS 依赖 -->
    <script src="~/layuimini/lib/jquery-3.4.1/jquery-3.4.1.min.js" charset="utf-8"></script>
    <script src="~/layuimini/lib/layui-v2.9.6/layui.js" charset="utf-8"></script>
    <script src="~/js/crypto-js.min.js" charset="utf-8"></script>
    <script src="~/js/XHD.js" charset="utf-8"></script>

    <script>
        // 登录过期的时候，跳出ifram框架
        if (top.location != self.location) top.location = self.location;

        // 全局请求锁，防止重复提交
        window.isLogining = false;

        // 刷新验证码（带时间戳）
        function refreshCaptcha(imgElement) {
            if (!imgElement) {
                imgElement = document.getElementById('captchaPic');
            }
            var src = imgElement.src.split('?')[0];
            imgElement.src = src + '?' + new Date().getTime();
        }

        // Cookie 工具
        function SetCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            var nameEQ = name + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        layui.use(['form', 'layer'], function() {
            var form = layui.form,
                layer = layui.layer;

            // 验证规则
            form.verify({
                account: function(value) {
                    if (value.trim() === '') return '用户名不能为空';
                    if (value.length < 2) return '用户名至少2个字符';
                },
                password: function(value) {
                    if (value.trim() === '') return '密码不能为空';
                    if (value.length < 3) return '密码长度不能小于3位';
                },
                captcha: function(value) {
                    if (value.trim() === '') return '图形验证码不能为空';
                    if (value.length < 4) return '验证码格式错误';
                }
            });

            // 表单验证
            function validateLoginForm() {
                var uid = $('#uid').val(),
                    pwd = $('#pwd').val(),
                    valicode = $('#valicode').val();
                if (!uid) return {
                    success: false,
                    msg: '用户名不能为空'
                };
                if (!pwd) return {
                    success: false,
                    msg: '密码不能为空'
                };
                if (!valicode) return {
                    success: false,
                    msg: '验证码不能为空'
                };
                return {
                    success: true
                };
            }

            // 登录提交
            function doLogin() {
                if (window.isLogining) {
                    layer.msg('正在登录中，请勿重复操作', {
                        icon: 7
                    });
                    return;
                }

                var check = validateLoginForm();
                if (!check.success) {
                    layer.msg(check.msg, {
                        icon: 5
                    });
                    return;
                }

                var uid = $('#uid').val();
                var pwd = $('#pwd').val();
                var valicode = $('#valicode').val();
                var AES_Key = '@ViewBag.AES_Key';
                var encrypted = pwd;

                try {
                    if (typeof encryptAES === 'function') {
                        encrypted = encryptAES(pwd, AES_Key);
                    }
                } catch (e) {
                    console.error('加密失败', e);
                }

                var $btn = $('#btn_login');
                var txt = $btn.text();
                window.isLogining = true;
                $btn.text("登录中...").attr("disabled", true).addClass("layui-disabled");

                $.ajax({
                    type: 'POST',
                    url: '/Account/Login/',
                    data: {
                        uid: uid,
                        pwd: encrypted,
                        valicode: valicode
                    },
                    dataType: 'json',
                    success: function(res) {
                        if (res.code === 0) {
                            SetCookie("XHD_uid", uid, 30);
                            layer.msg('登录成功，跳转中...', {
                                icon: 1,time: 1000
                            }, () => window.location.href = "/");
                        }
                        else if(res.code===-9) {
                                layer.msg('系统错误，请重新输入！', {
                                icon: 0,
                                time: 1000
                            }, () => window.location.reload());
                        }
                        else {
                            layer.alert(res.msg || '登录失败', {
                                icon: 5
                            });
                            refreshCaptcha();
                            $('#pwd').val('');
                            resetBtn();
                        }
                    },
                    error: function() {
                        layer.alert('请求失败，请检查网络', {
                            icon: 5
                        });
                        refreshCaptcha();
                        resetBtn();
                    }
                });

                function resetBtn() {
                    $btn.text(txt).removeAttr("disabled").removeClass("layui-disabled");
                    window.isLogining = false;
                }
            }

            // 绑定事件
            $('#btn_login').click(e => {
                e.preventDefault();
                doLogin();
            });
            $(document).keypress(e => {
                if ((e.which || e.keyCode) === 13 && !window.isLogining) doLogin();
            });

            // 自动填充用户名
            if (getCookie("XHD_uid")) {
                $("#uid").val(getCookie("XHD_uid"));
            }
        });
    </script>
</body>
</html>