@{
    ViewData["Title"] = "Add";
}
<style type="text/css">
    .downpanel .layui-select-title span { line-height: 38px; }
    .downpanel dl dd:hover { background-color: inherit; }
    #treeclass { width: 190px; }
    body .layui-layer-content { overflow: visible; }
    #toolbar { padding: 5px 0; }
    .layui-form-selected dl { z-index: 99999; }
</style>

<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")
    @Html.Hidden("news_content")
    @Html.Hidden("news_type")

    <div class="layui-card">
        <div class="layui-card-header">信息</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">标题</label>
                    <div class="layui-input-inline">
                        <input type="text" name="news_title" id="news_title" placeholder="标题" lay-verify="required" autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">类型</label>
                    <div class="layui-input-inline">
                        <select id="news_type_id" name="news_type_id" lay-verify="required">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="layui-form-item">
            </div>
            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>
        </div>
    </div>
</div>

<div class="layui-card">
    <div class="layui-card-body layui-text">
        <div id="w-toolbar"></div>
        <div id="w-text" style="height:400px;"></div>
    </div>
</div>

<script>
    var id = null;
    var editor = null;
    var f_save;

    layui.use(['tree', 'form', 'layer', 'table', 'laydate', 'wangEditor'], function() {
        var form = layui.form,
            tree = layui.tree,
            layer = layui.layer,
            $ = layui.$;
        var table = layui.table;
        var laydate = layui.laydate;
        // 读取封装好的wangEditor V3
        var wangEditor = layui.wangEditor;

        // ========== 初始化 wangEditor V3 ==========
        editor = new wangEditor('#w-text');

        // ========== 自定义菜单：移除 video(视频)、code(代码)，其余全部保留 ==========
        editor.customConfig.menus = [
            'head',
            'bold',
            'fontSize',
            'fontName',
            'italic',
            'underline',
            'strikeThrough',
            'foreColor',
            'backColor',
            'list',
            'justify',
            'image',
            'table',
            'undo',
            'redo'
        ];

        // 图片上传配置，沿用原有上传地址 /Upload/Image
        editor.customConfig.uploadImgServer = '/Upload/Image';
        editor.customConfig.uploadFileName = 'file'; //后端接收的字段名 file，和tinymce保持一致
        editor.customConfig.uploadImgMaxSize = 5 * 1024 * 1024;


        editor.customConfig.uploadImgHooks = {
            // 上传超时
            timeout: function(xhr, editor) {
                layer.msg('上传超时！')
            },
            // 如果服务器端返回的不是 {errno:0, data: [...]} 这种格式，可使用该配置
            customInsert: function(insertImg, result, editor) {
                console.log(result);
                if (result.location ) {
                    var url = result.location;
                    insertImg(url);                   
                } else {
                    layer.msg("图片上传失败");
                }
            }            
        };

        // 创建编辑器
        editor.create();

        // 编辑回显：读取隐藏域解码，设置到编辑器
        var initContent = myHTMLDeCode($("#news_content").val() || "");
        if (initContent) {
            editor.txt.html(initContent);
        }

        // ========== 保存函数，完全兼容原有业务逻辑 ==========
        f_save = function() {
            // V3 获取html内容 API：editor.txt.html()
            var html = editor.txt.html();
            console.log(myHTMLEnCode(html));
            $("#news_content").val(myHTMLEnCode(html));
            return false;
        };

        // ========== 原有下拉加载逻辑完全不动 ==========
        $.ajax({
            url: "/SysParam/Combo",
            data: { type: "message_type" },
            type: "post",
            dataType: "json",
            success: function(data) {
                var data = data.data;
                var category = $('#news_type_id');
                category.html("");
                category.append('<option value="">请选择</option>');
                for (var i = 0; i < data.length; i++) {
                    category.append("<option value='" + data[i]["id"] + "'>" + data[i]["params_name"] + "</option>");
                };

                if ($("#news_type").val()) {
                    setTimeout(function() {
                        var select = 'dd[lay-value=' + $("#news_type").val() + ']';
                        $(category).siblings("div.layui-form-select").find('dl').find(select).click();
                        $("#data-search-btn").click();
                    }, 50)
                }
                form.render("select");
            },
        });

    });
</script>
