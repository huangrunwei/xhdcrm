@{
    ViewData["Title"] = "AI 接入令牌";
}

<style>
    .token-page { width: 100%; max-width: none; margin: 0; padding: 18px 22px 40px; box-sizing: border-box; }
    .token-hero { background: linear-gradient(118deg, #0b2748, #123f66 55%, #0c6b6a); color: #fff; border-radius: 16px; padding: 24px 26px; box-shadow: 0 12px 28px rgba(15,42,72,.16); }
    .token-hero h1 { margin: 0 0 8px; font-size: 24px; font-weight: 800; }
    .token-hero p { margin: 0; max-width: 820px; line-height: 1.75; color: rgba(255,255,255,.78); font-size: 13px; }
    .token-tip { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
    .token-tip span { padding: 4px 10px; border-radius: 20px; background: rgba(255,255,255,.12); font-size: 11px; color: rgba(255,255,255,.9); }
    .token-card { margin-top: 16px; background: #fff; border-radius: 14px; padding: 18px; border: 1px solid #edf1f6; box-shadow: 0 1px 3px rgba(15,23,42,.05); }
    .token-card .layui-table-view { margin: 0; }
    .token-form { padding: 22px 24px; }
    .token-form .layui-form-label { width: 92px; }
    .token-form .layui-input-block { margin-left: 122px; }
    .token-form .layui-form-item { margin-bottom: 16px; }
    .token-note { color: #94a3b8; font-size: 12px; line-height: 1.7; }
    .token-result { padding: 20px 22px; }
    .token-result textarea { width: 100%; height: 88px; padding: 10px 12px; border: 1px solid #dbe3ef; border-radius: 8px; font-family: Consolas, monospace; font-size: 12px; resize: none; background: #f8fafc; }
    .token-result .token-warn { color: #b45309; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px; padding: 9px 12px; font-size: 12px; margin-bottom: 12px; }
    .token-actions { margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end; }
    .token-mask { font-family: Consolas, monospace; white-space: nowrap; letter-spacing: .2px; }
</style>

<div class="token-page">
    <div class="token-hero">
        <h1>AI 接入令牌</h1>
        <p>为 WorkBuddy、Cursor、Claude 等 AI 客户端分别创建独立 Token。Token 长期有效，可随时撤销；每个 Token 使用原系统的数据权限、菜单权限和按钮权限，不会绕过 Web 权限。</p>
        <div class="token-tip">
            <span>多个 Token 可区分不同 AI</span>
            <span>长期有效</span>
            <span>只显示一次完整 Token</span>
            <span>可随时撤销</span>
        </div>
    </div>

    <div class="token-card">
        <table id="tokenTable" lay-filter="tokenTable"></table>
    </div>
</div>

<script type="text/html" id="tokenToolbar">
    <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="create"><i class="layui-icon layui-icon-add-1"></i> 新建 Token</button>
</script>
<script type="text/html" id="tokenStatusTpl">
    {{# if(d.is_revoked){ }}
        <span class="layui-badge layui-bg-gray">已撤销</span>
    {{# } else if(d.status === '已过期'){ }}
        <span class="layui-badge layui-bg-orange">已过期</span>
    {{# } else { }}
        <span class="layui-badge layui-bg-green">正常</span>
    {{# } }}
</script>
<script type="text/html" id="tokenBar">
    {{# if(!d.is_revoked){ }}
        <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="revoke">撤销</a>
    {{# } }}
</script>

<script>
    layui.use(['table', 'layer', 'form'], function () {
        var table = layui.table;
        var layer = layui.layer;
        var form = layui.form;
        var $ = layui.$;

        table.render({
            elem: '#tokenTable',
            url: '/ApiToken/Grid',
            toolbar: '#tokenToolbar',
            defaultToolbar: ['filter'],
            page: false,
            cols: [[
                { field: 'token_name', title: 'Token 名称', minWidth: 150 },
                { field: 'token_mask', title: 'Token（前缀 + 尾部）', minWidth: 420, templet: function (d) { return '<span class="token-mask">' + d.token_mask + '</span>'; } },
                { field: 'remarks', title: '备注', minWidth: 160 },
                { field: 'create_time', title: '创建时间', width: 155 },
                { field: 'last_used_at', title: '最近使用', width: 155 },
                { field: 'expires_at', title: '有效期至', width: 120 },
                { field: 'status', title: '状态', width: 100, templet: '#tokenStatusTpl' },
                { title: '操作', width: 90, templet: '#tokenBar', fixed: 'right' }
            ]]
        });

        table.on('toolbar(tokenTable)', function (obj) {
            if (obj.event === 'create') openCreate();
        });

        table.on('tool(tokenTable)', function (obj) {
            if (obj.event === 'revoke') {
                layer.confirm('撤销后该 Token 立即失效，确定撤销「' + obj.data.token_name + '」？', { icon: 3, title: '提示' }, function (index) {
                    $.post('/ApiToken/Revoke', { id: obj.data.id }, function (res) {
                        layer.close(index);
                        if (res.code === 0) {
                            layer.msg('已撤销', { icon: 1 });
                            table.reload('tokenTable');
                        } else {
                            layer.msg(res.msg || '撤销失败', { icon: 2 });
                        }
                    }, 'json');
                });
            }
        });

        function openCreate() {
            layer.open({
                type: 1,
                title: '新建 AI 接入 Token',
                area: ['min(820px, 94vw)', 'auto'],
                content: '<div class="token-form">'
                    + '<form class="layui-form" lay-filter="tokenForm">'
                    + '<div class="layui-form-item"><label class="layui-form-label">Token 名称</label><div class="layui-input-block"><input type="text" name="tokenName" class="layui-input" placeholder="例如：WorkBuddy / Cursor / Claude" autocomplete="off"></div></div>'
                    + '<div class="layui-form-item"><label class="layui-form-label">备注</label><div class="layui-input-block"><input type="text" name="remarks" class="layui-input" placeholder="可选，例如：用于销售分析" autocomplete="off"></div></div>'
                    + '<div class="layui-form-item"><label class="layui-form-label">有效期</label><div class="layui-input-block"><select name="expiresDays"><option value="3650" selected>10 年（推荐）</option><option value="365">1 年</option><option value="36500">100 年</option></select></div></div>'
                    + '<div class="layui-form-item"><div class="layui-input-block token-note">Token 只在创建成功时显示一次，请立即复制保存。不同 AI 建议使用不同 Token，方便单独撤销和审计。</div></div>'
                    + '<div class="layui-form-item"><div class="layui-input-block" style="text-align:right;"><button type="button" class="layui-btn layui-btn-primary" id="tokenCancel">取消</button><button type="button" class="layui-btn layui-btn-normal" id="tokenSubmit">创建</button></div></div>'
                    + '</form></div>',
                success: function (layero) {
                    form.render();
                    layero.find('#tokenCancel').on('click', function () { layer.closeAll(); });
                    layero.find('#tokenSubmit').on('click', function () {
                        var tokenName = layero.find('input[name=tokenName]').val();
                        var remarks = layero.find('input[name=remarks]').val();
                        var expiresDays = layero.find('select[name=expiresDays]').val();
                        if (!tokenName) { layer.msg('请填写 Token 名称', { icon: 2 }); return; }
                        var loading = layer.load(2);
                        $.post('/ApiToken/Create', { tokenName: tokenName, remarks: remarks, expiresDays: expiresDays }, function (res) {
                            layer.close(loading);
                            if (res.code !== 0) { layer.msg(res.msg || '创建失败', { icon: 2 }); return; }
                            layer.closeAll();
                            showToken(res.data);
                            table.reload('tokenTable');
                        }, 'json');
                    });
                }
            });
        }

        function showToken(data) {
            var safeToken = $('<div>').text(data.token).html();
            layer.open({
                type: 1,
                title: 'Token 创建成功',
                area: ['min(860px, 94vw)', 'auto'],
                closeBtn: 1,
                content: '<div class="token-result">'
                    + '<div class="token-warn">请立即复制并妥善保存。关闭窗口后，完整 Token 不再显示。</div>'
                    + '<textarea id="newTokenText" readonly>' + safeToken + '</textarea>'
                    + '<div class="token-note" style="margin-top:8px;">名称：' + $('<div>').text(data.token_name).html() + '，有效期至：' + (data.expires_at || '长期') + '</div>'
                    + '<div class="token-actions"><button class="layui-btn layui-btn-sm layui-btn-primary" id="copyToken">复制 Token</button><button class="layui-btn layui-btn-sm layui-btn-normal" id="closeToken">我已保存</button></div>'
                    + '</div>',
                success: function (layero) {
                    layero.find('#copyToken').on('click', function () {
                        var text = layero.find('#newTokenText').val();
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(text).then(function () { layer.msg('已复制', { icon: 1 }); });
                        } else {
                            layero.find('#newTokenText')[0].select();
                            document.execCommand('copy');
                            layer.msg('已复制', { icon: 1 });
                        }
                    });
                    layero.find('#closeToken').on('click', function () { layer.closeAll(); });
                }
            });
        }
    });
</script>
