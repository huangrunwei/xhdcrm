    function echarts_customer(data) {

        var seriesdata=[];
        for(var i=0;i<data.length;i++)
        {
            seriesdata.push(data[i].count);
        }

        // 基于准备好的dom，初始化echarts实例
        var myChart = echarts.init(document.getElementById('echarts-customer'));
        option = {            
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'shadow'
                }
            },
            xAxis: {
                type: 'category',
                data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'],
                splitLine:{
                    show:false
                },
                axisLabel:{
                        color: '#ffffff'
                    }
            },
            yAxis: {
                type: 'value',
                splitLine:{
                    show:false
                },
                axisLabel:{
                        color: '#ffffff'
                    }
            },
            grid:{
                left:'10%',
                right:'1%',
                top:'10%',
                bottom:'15%'
            },
            series: [
                {
                    data: seriesdata,
                    type: 'bar',
                    showBackground: false,
                    backgroundStyle: {
                        color: 'rgba(180, 180, 180, 0.2)'
                    }
                }
            ]
        };
        // 使用刚指定的配置项和数据显示图表。
        myChart.setOption(option);
        window.addEventListener("resize", function () {
            myChart.resize();
        });
    }

