@{
    ViewData["Title"] = "Index";
}

<div class="layuimini-container">
    <div class="layuimini-main">
        <!-- 搜索区域 -->
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <form class="layui-form layui-form-pane" action="">
                <div class="layui-form-item layui-inline">
                    <label class="layui-form-label">联系人</label>
                    <div class="layui-input-inline">
                        <input type="text" name="C_name" id="C_name" autocomplete="off" class="layui-input">
                    </div>
                </div>

                <!-- 按钮组 + 展开/折叠，单独一个行内块容器 -->
                <div class="btn-group-inline">
                    <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn" id="btn_serch"><i class="layui-icon layui-icon-search"></i> 搜索</button>
                    <button type="reset" class="layui-btn layui-btn-primary" id="btn_reset"><i class="layui-icon layui-icon-error"></i> 重置</button>
                    <!-- 展开/折叠按钮 -->
                    <a id="toggleBtn" style="cursor:pointer;">
                        <i class="layui-icon layui-icon-down"></i>
                        <span>展开</span>
                    </a>
                </div>
                
                <!-- 展开/折叠区域 -->
                <div id="extraConditions" style="display: none;">
                    <div class="layui-form-item layui-inline">
                        <label class="layui-form-label">客户</label>
                        <div class="layui-input-inline">
                            <input type="text" name="cus_name" id="cus_name" autocomplete="off" class="layui-input">
                        </div>
                    </div>
                    <div class="layui-form-item layui-inline">
                        <label class="layui-form-label">电话</label>
                        <div class="layui-input-inline">
                            <input type="text" name="C_tel" id="C_tel" autocomplete="off" class="layui-input">
                        </div>
                    </div>
                </div>

               

            </form>
        </fieldset>

        <!-- 表格工具栏 -->
        <script type="text/html" id="toolbarDemo">
                    <div class="layui-btn-container">
                            <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add">添加</button>
                            <button class="layui-btn layui-btn-sm layui-bg-orange" lay-event="export">导出</button>
                    </div>
        </script>

        <!-- 表格主体 -->
        <table id="munu-table" class="layui-table" lay-filter="currentTableFilter"></table>

        <!-- 行操作模板 -->
        <script type="text/html" id="auth-state">
                    <a class="layui-btn layui-btn-xs" lay-event="info">详情</a>
                    <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">修改</a>
                    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
        </script>

        <!-- 隐藏的导出表单 -->
        <form id="form_excel" style="display:none;"></form>
    </div>
</div>

<script>
    layui.use(['table', 'form', 'layer'], function () {
        var $ = layui.jquery;
        var table = layui.table;
        var form = layui.form;
        var layer = layui.layer;

        // --- 1. 表格渲染 ---
        // 使用变量存储表格配置，便于后续调用
        var tableOptions = {
            elem: '#munu-table',
            url: 'Grid',
            toolbar: '#toolbarDemo',
            defaultToolbar: ['filter'],
            id: "mainGrid4",
            cols: [[
                { type: 'numbers', fixed: 'left', title: "序号" },
                { field: 'C_name', width: 100, title: '联系人', fixed: 'left' },
                {
                    field: 'C_tel', width: 150, title: '电话',
                    templet: function(d) {
                        return d.C_tel ? '<i class="fa fa-phone"></i> ' + d.C_tel : '';
                    }
                },
                {
                    field: 'cus_name', width: 250, title: '客户',
                    templet: function(d) { return d.customer ? d.customer.cus_name : ""; }
                },
                {
                    field: 'C_email', width: 180, title: '邮箱',
                    templet: function(d) {
                        return d.C_email ? '<i class="fa fa-envelope"></i> ' + d.C_email : '';
                    }
                },
                { field: 'create_time', width: 180, title: '创建时间' },
                {
                    field: 'Creater', width: 150, title: '创建人',
                    templet: function(d) { return d.Creater ? d.Creater.name : ""; }
                },
                { templet: '#auth-state', width: 200, align: 'center', fixed: "right", title: '操作' }
            ]],
            page: true,
            limit: 15,
            limits: [10, 15, 20, 25, 50, 100]
        };

        // 渲染表格
        table.render(tableOptions);

        // --- 2. 事件监听 ---

        // 搜索提交
        form.on('submit(data-search-btn)', function (data) {
            table.reload('mainGrid4', {
                page: { curr: 1 }, // 搜索时重置到第一页
                where: data.field
            });
            return false; // 阻止表单默认提交
        });

        // 表格头部工具栏
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {
                openAddEditModal();
            } else if (obj.event === 'export') {
                exportData();
            }
        });

        // 表格行工具
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            var layEvent = obj.event;

            if (layEvent === 'del') {
                layer.confirm('确定删除？', { icon: 3, title: '提示信息' }, function (index) {
                    deleteData(data.id);
                    layer.close(index);
                });
            } else if (layEvent === 'edit') {
                if (data.isMenu != 1) { // 逻辑修正：通常 isMenu 为 1 时表示是菜单，不可编辑
                    openAddEditModal(data);
                }
            } else if (layEvent === 'info') {
                openInfoModal(data);
            }
        });

        // 展开/折叠搜索条件
        $('#toggleBtn').on('click', function () {
            var $extra = $('#extraConditions');
            var $icon = $(this).find('i');
            var $span = $(this).find('span');
        
            if ($extra.is(':visible')) {
                $extra.slideUp(200);
                $icon.removeClass('layui-icon-up').addClass('layui-icon-down');
                $span.text('展开');
            } else {
                $extra.slideDown(200, function () {
                    form.render(); // 重新渲染表单元素
                });
                $icon.removeClass('layui-icon-down').addClass('layui-icon-up');
                $span.text('收起');
            }
        });

        // --- 3. 功能函数 ---

        // 导出数据
        function exportData() {
            $("#form_excel").attr({ "method": "get", "action": "Export" }).submit();
        }

        // 删除数据
        function deleteData(id) {
            $.ajax({
                type: 'POST',
                url: "Delete",
                data: { id: id },
                dataType: "json",
                success: function (res) {
                    if (res.code === 0) {
                        table.reload('mainGrid4'); // 刷新表格
                    } else {
                        layer.alert(res.msg, { icon: 5 });
                    }
                },
                error: function (xhr) {
                    layer.alert('操作失败：' + xhr.status, { icon: 5 });
                }
            });
        }

        // 打开添加/编辑弹窗
        function openAddEditModal(editData) {
            var isEdit = !!editData;
            var title = isEdit ? "编辑" : "添加";
            var id = isEdit ? editData.id : "";

            var index = layer.open({
                title: title,
                type: 2,
                anim: 1,
                area: ['80%', '80%'],
                maxmin: true,
                content: "Add?id=" + id,
                btn: ['确定', '关闭'],
                success: function (layero, index) {
                    if (isEdit) {
                        populateIframeData(layero, index, editData);
                    }
                },
                yes: function (index, layero) {
                    //var res = window["layui-layer-iframe" + index].f_save();
                    //var res = window["layui-layer-iframe" + index].callbackdata();
                    ////打印返回的值，看是否有我们想返回的值。
                    //console.log(res);
                    //layer.close(index);
                    var iframeWindow = window['layui-layer-iframe' + index]
                        , submitID = 'LAY-user-front-submit'
                        , submit = layero.find('iframe').contents().find('#' + submitID);

                    //监听提交
                    iframeWindow.layui.form.on('submit(' + submitID + ')', function (data) {
                        var field = data.field; //获取提交的字段

                        console.log(data.field);

                        //layer.close(index); //关闭弹层

                        $.ajax({
                            type: 'POST',
                            url: 'Save',
                            data: data.field,
                            dataType: "json",
                            success: function (res) {//res为相应体,function为回调函
                                layer.close(index); //关闭弹层
                                f_reload();
                            },
                            error: function (XMLHttpRequest, textStatus, errorThrown) {
                                layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                            }
                        });
                    });

                    submit.trigger('click');
                }
            });
        }

        // 打开详情弹窗
        function openInfoModal(data) {
            var index = layer.open({
                title: "详情",
                type: 2,
                anim: 1,
                area: ['80%', '80%'],
                maxmin: true,
                content: "Add?id=" + data.id,
                btn: ['关闭'],
                success: function (layero, index) {
                    populateIframeData(layero, index, data);
                }
            });
        }

        // 填充 iframe 表单数据 (复用逻辑)
        function populateIframeData(layero, index, data) {
            var body = layer.getChildFrame('body', index);
            for (var key in data) {
                if (data.hasOwnProperty(key)) {
                    var value = data[key];
                    // 处理日期格式
                    if (typeof value === 'string' && !isNaN(Date.parse(value))) {
                        value = value.replace(' 00:00:00', '');
                    }
                    body.find("#" + key).val(value);
                }
            }
            // 处理关联数据
            if (data.customer) {
                body.find("#customer_val").val(data.customer.id);
                body.find("#customer_name").val(data.customer.cus_name);
            }
        }
    });
</script>