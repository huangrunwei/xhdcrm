                        <div class="layui-form-item">
                            欢迎使用小黄豆CRM，现在开始为您配置，请点击开始配置按钮！
                        </div>

                        <div class="layui-form-item ">
                            @*<button type="button" class="layui-btn" id="btn_connect">测试连接</button>*@
