@{
    ViewData["Title"] = "Index";
}



<div class="layuimini-container">
    <div class="layuimini-main">
        <fieldset class="table-search-fieldset">
            <legend>搜索信息</legend>
            <div style="margin: 10px 10px 10px 10px">
                <form class="layui-form layui-form-pane" action="">
                    <div class="layui-form-item">
                        <div class="layui-inline">
                            <label class="layui-form-label">联系人</label>
                            <div class="layui-input-inline">
                                <input type="text" name="C_name" id="C_name" autocomplete="off" class="layui-input">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">客户</label>
                            <div class="layui-input-inline">
                                <input type="text" name="cus_name" id="cus_name" autocomplete="off" class="layui-input">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <label class="layui-form-label">电话</label>
                            <div class="layui-input-inline">
                                <input type="text" name="C_tel" id="C_tel" autocomplete="off" class="layui-input">
                            </div>
                        </div>
                        <div class="layui-inline">
                            <button type="submit" class="layui-btn layui-btn-primary" lay-submit lay-filter="data-search-btn" id="btn_serch"><i class="layui-icon"></i> 搜 索</button>
                            <button type="reset" class="layui-btn layui-btn-primary" id="btn_reset"><i class="layui-icon"></i> 重置</button>
                        </div>
                    </div>
                </form>
            </div>
        </fieldset>

        <script type="text/html" id="toolbarDemo">
            <div class="layui-btn-container">
                @*<button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add">添加</button>
                    <button class="layui-btn layui-btn-sm layui-bg-orange" lay-event="export">导出</button>*@
            </div>
        </script>

        <table id="munu-table" class="layui-table" lay-filter="currentTableFilter"></table>
    </div>
</div>
<!-- 操作列 -->
<script type="text/html" id="auth-state">
    @*<a class="layui-btn layui-btn-xs" lay-event="info">详情</a>
        <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">修改</a>
        <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>*@
    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="down">下载</a>
</script>
<form id="form_excel"></form>
<script>
    layui.use(['table', 'treetable', 'form'], function () {
        var $ = layui.jquery;
        var table = layui.table;
        var treetable = layui.treetable;
        var form = layui.form;

        // 渲染表格
        layer.load(2);
        table.render({
            elem: '#munu-table',
            url: 'Grid?id=all',
            page: false,
            toolbar: '#toolbarDemo',
            defaultToolbar: ['filter'],
            id: "mainGrid4",
            cols: [[
                { type: 'numbers', fixed: 'left' ,title:"序号" },
                { field: 'file_name', width: 400, title: '文件名', fixed: 'left' },
                {
                    field: 'cus_name', width: 250, title: '客户', templet: function (item) {
                        var html = "<i class='fa fa-user'></i>";
                        if (item.Customer)
                            html += item.Customer.cus_name;

                        return html;
                    }
                },

                {
                    field: 'cus_industry', width: 180, title: '行业', templet: function (item) {
                        if (item.Customer && item.Customer.cus_industry)
                            return item.Customer.cus_industry.params_name;

                        return "";
                    }
                },

                { field: 'create_time', width: 180, title: '创建时间' },

                {
                    width: 200, align: 'center', fixed: "right", title: '操作', fixed: 'right', templet: function (t) {
                        var html = "<a href='/upload/DownloadCustomerAtta?id=" + t.id + "' target='_blank'>下载</a>";

                        return html;
                    }
                }
            ]],
            limits: [10, 15, 20, 25, 50, 100],
            limit: 15,
            page: true,
            done: function () {
                layer.closeAll('loading');
            }
        });

        /**
        * toolbar监听事件
        */
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {  // 监听添加操作
                add();
                return;
            }
            if (obj.event === 'export') {  // 监听添加操作
                Export();
                return;
            }
        });

        function Export() {
            var file = "Export";
            $("#form_excel").attr("method", "get");
            $("#form_excel").attr("action", file);
            $("#form_excel").submit();
        }



        //监听工具条
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            var layEvent = obj.event;

            if (layEvent === 'del') {
                layer.confirm('确定删除？', { icon: 3, title: '提示信息' }, function (index) {
                    del(data.id);
                    layer.close(index);
                });

                //layer.msg('删除' + data.id);
            }
            else if (layEvent === 'edit') {
                if (data.isMenu == 1) {
                    return;
                }
                add(data);
            }
            else if (layEvent === "info") {
                info(data);
            }
            else if (layEvent === "down") {



                console.log(data);

                var url = '/upload/DownloadCustomerAtta?id=' + data.id;

                $("#form_excel").attr("method", "get");
                $("#form_excel").attr("action", url);
                $("#form_excel").submit();
                //$("#form_excel").attr("action", html).submit();

                //return html;
            }
        });

        function info(data) {
            var index = layui.layer.open({
                title: "详情",
                type: 2,
                anim: 1,
                area: ['80%', '80%'],
                maxmin: true,
                content: "Add?id=" + data.id,
                btn: ['关闭'],
                success: function (layero, index) {
                    var iframe = window["layui-layer-iframe" + index];
                    var body = layui.layer.getChildFrame('body', index);
                    if (data) {
                        for (var val in data) {
                            var value = data[val];
                            if (isNaN(value) && !isNaN(Date.parse(value))) {
                                value = value.replace(' 00:00:00', '');
                            }
                            body.find("#" + val).val(value);
                        }
                        body.find("#customer_val").val(data.customer_id);
                        body.find("#customer_name").val(data.customer.cus_name);
                    }
                },
                btn2: function (index, layero) {
                    layer.close(index);
                }

            });
        }


        function del(id) {
            $.ajax({
                type: 'POST',
                url: "Delete",
                data: { id: id },
                dataType: "json",
                success: function (res) {//res为相应体,function为回调函数
                    if (res.code == 0) {
                        f_reload();
                    }
                    else {
                        layer.alert(res.msg, { icon: 5 });
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                }
            });
        }


        //添加目录
        function add(edit) {
            var tit = "添加";
            if (edit) {
                tit = "编辑";
            }

            var id = "";
            if (edit) {
                id = edit.id;
            }


            var index = layui.layer.open({
                title: tit,
                type: 2,
                anim: 1,
                area: ['80%', '80%'],
                maxmin: true,
                content: "Add?id=" + id,
                btn: ['确定', '关闭'],
                success: function (layero, index) {
                    var iframe = window["layui-layer-iframe" + index];
                    var body = layui.layer.getChildFrame('body', index);
                    if (edit) {
                        for (var val in edit) {
                            var value = edit[val];
                            if (isNaN(value) && !isNaN(Date.parse(value))) {
                                value = value.replace(' 00:00:00', '');
                            }
                            body.find("#" + val).val(value);
                        }
                        body.find("#customer_val").val(edit.customer_id);
                        body.find("#customer_name").val(edit.customer.cus_name);
                    }
                },
                yes: function (index, layero) {
                    //var res = window["layui-layer-iframe" + index].f_save();
                    //var res = window["layui-layer-iframe" + index].callbackdata();
                    ////打印返回的值，看是否有我们想返回的值。
                    //console.log(res);
                    //layer.close(index);
                    var iframeWindow = window['layui-layer-iframe' + index]
                        , submitID = 'LAY-user-front-submit'
                        , submit = layero.find('iframe').contents().find('#' + submitID);

                    //监听提交
                    iframeWindow.layui.form.on('submit(' + submitID + ')', function (data) {
                        var field = data.field; //获取提交的字段

                        console.log(data.field);

                        layer.close(index); //关闭弹层

                        $.ajax({
                            type: 'POST',
                            url: 'Save',
                            data: data.field,
                            dataType: "json",
                            success: function (res) {//res为相应体,function为回调函数
                                f_reload();
                            },
                            error: function (XMLHttpRequest, textStatus, errorThrown) {
                                layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                            }
                        });
                    });

                    submit.trigger('click');
                },
                btn2: function (index, layero) {
                    layer.close(index);
                }

            });
        }

        function f_reload(id) {
            $("#btn_serch").click();
        }

        // 监听搜索操作
        form.on('submit(data-search-btn)', function (data) {
            var curr = $(".layui-laypage-skip").find("input").val();
            if (!curr) {
                curr = 1;
            }

            //var result = JSON.stringify(data.field);
            //layer.alert(result, {
            //    title: '最终的搜索信息'
            //});

            //执行搜索重载
            table.reload('mainGrid4', {
                page: {
                    curr: curr
                }
                , where: data.field
            }, 'data');

            return false;
        });
    });
</script>
