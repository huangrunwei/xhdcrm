@{
    ViewData["Title"] = "Index";
}
<div class="layui-row layui-col-space15">
    <div class="layui-col-sm3 layui-col-lg2">
        <div class="layuimini-card" style="min-height:600px;">
            <div class="layuimini-card-header">参数类别</div>
            
            <div class="layuimini-card-body">
                <div id="param_category" class="demo-tree demo-tree-box"></div>
            </div>
        </div>
    </div>
    <div class="layui-col-sm9  layui-col-lg10">
        <div class="layuimini-card" style="min-height:600px;">
            <div class="layuimini-card-header">产品列表</div>
            <div class="layuimini-card-body">
                <script type="text/html" id="toolbarDemo">
                    <div class="layui-btn-container">
                        <button class="layui-btn layui-btn-sm data-add-btn" lay-event="add"> 添加 </button>
                    </div>
                </script>

                <table class="layui-hide" id="munu-table" lay-filter="currentTableFilter"></table>

                <script type="text/html" id="currentTableBar">
                    <a class="layui-btn layui-btn-xs data-count-edit" lay-event="edit">编辑</a>
                    <a class="layui-btn layui-btn-xs layui-btn-danger data-count-delete" lay-event="del">删除</a>
                </script>
            </div>
        </div>
    </div>
</div>

<style>
 /*   .layui-table, .layui-table-view{margin:0 !important;}*/
</style>
<script type="text/javascript">
    var category_id = null;
    layui.use(['table', 'treetable', 'form', 'tree'], function () {
        var $ = layui.jquery;
        var table = layui.table;
        var form = layui.form;
        var treetable = layui.treetable;
        var tree = layui.tree;

        // 渲染表格
        layer.load(2);
        table.render({
            elem: '#munu-table',
            url: 'Grid',
            page: false,
            cols: [[
                { type: 'numbers',title:"序号"  },
                { field: 'Category', width: 200, title: '类别',templet:function(t)
                    {
                        if(t.Category)
                        {
                            return t.Category.category_name
                        }
                    }
                },
                { field: 'product_name', width: 200, title: '产品名' },
                { field: 'unit', width: 120, title: '单位' },
                //{ field: 'cost', width: 120, title: '成本' },
                { field: 'price', width: 120, title: '售价' },
                //{ field: 'agio', width: 120, title: '折扣' },
                { field: 'specifications', width: 120, title: '规格' },
                { field: 'remarks', width: 120, title: '备注' },
                { templet: '#currentTableBar', width: 120, align: 'center', fixed: 'right', title: '操作' }
            ]],
            toolbar: '#toolbarDemo',
            defaultToolbar: ['filter'],
            limits: [10, 15, 20, 25, 50, 100],
            limit: 15,
            page: true,
            done: function () {
                layer.closeAll('loading');
            }
        });


        //下拉
        $.ajax({
            url: "/ProductCategory/TreeAll",
            type: "post",
            dataType: "json",
            success: function (data) {
                tree.render({
                    elem: "#param_category",
                    data: data,
                    //showLine: false,
                    id: "params_type",
                    click: function (node) {
                        console.log(node);

                        category_id = node.data.id;

                        table.reload("munu-table", {
                            page: {
                                curr: 1 //重新从第 1 页开始
                            },
                            where: {
                                T_type: node.data.id
                            }
                        });
                    }
                });
                //var category = $('#param_category');
                //category.html("");
                //category.append('<option value="">请选择</option>');
                //for (var i = 0; i < data.length; i++) {

                //    console.log(data[i]);
                //    category.append("<option value='" + data[i]["id"] + "'>" + data[i]["text"] + "</option>");
                //}
                //form.render("select");
            },
        });

        $('#btn-menu').click(function () {
            add();
        });
        /**
         * toolbar监听事件
         */
        table.on('toolbar(currentTableFilter)', function (obj) {
            if (obj.event === 'add') {  // 监听添加操作
                add();
            }
        });


        //监听工具条
        table.on('tool(currentTableFilter)', function (obj) {
            var data = obj.data;
            var layEvent = obj.event;

            if (layEvent === 'del') {
                layer.confirm('确定删除？', { icon: 3, title: '提示信息' }, function (index) {
                    del(data.id);
                    layer.close(index);
                });

                //layer.msg('删除' + data.id);
            }
            else if (layEvent === 'edit') {
                add(data);
            }
        });

        $("#data-search-btn").on("click", function () {
            f_load();
        });

        function del(id) {
            var url = "del";

            $.ajax({
                type: 'POST',
                url: "Delete",
                data: { id: id },
                dataType: "json",
                success: function (res) {//res为相应体,function为回调函数
                    if(res.code==0)
                    {
                        f_reload();
                    }
                    else
                    {
                        layer.alert(res.msg, { icon: 5 });
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                }
            });
        }


        //添加目录
        function add(edit) {
            var tit = "添加";
            if (edit) {
                tit = "编辑";
            }
            console.log(edit);
            var index = layui.layer.open({
                title: tit,
                type: 2,
                anim: 1,
                area: ['600px', '550px'],
                maxmin: true,
                content: "Add",
                btn: ['确定', '关闭'],
                success: function (layero, index) {
                    var iframe = window["layui-layer-iframe" + index];
                    var body = layui.layer.getChildFrame('body', index);

                    if (edit) {
                        for (var val in edit) {
                            var value = edit[val];
                            if (isNaN(value) && !isNaN(Date.parse(value))) {
                                value = value.replace(' 00:00:00', '');
                            }
                            body.find("#" + val).val(value);
                        }
                        body.find("#params_type_id").val(edit.params_type);
                    }

                },
                yes: function (index, layero) {
                    //var res = window["layui-layer-iframe" + index].callbackdata();
                    ////打印返回的值，看是否有我们想返回的值。
                    //console.log(res);
                    //layer.close(index);
                    var iframeWindow = window['layui-layer-iframe' + index]
                        , submitID = 'LAY-user-front-submit'
                        , submit = layero.find('iframe').contents().find('#' + submitID);

                    //监听提交
                    iframeWindow.layui.form.on('submit(' + submitID + ')', function (data) {
                        var field = data.field; //获取提交的字段

                        console.log(data.field);

                        layer.close(index); //关闭弹层

                        $.ajax({
                            type: 'POST',
                            url: 'Save',
                            data: data.field,
                            dataType: "json",
                            success: function (res) {//res为相应体,function为回调函数
                                f_reload();
                            },
                            error: function (XMLHttpRequest, textStatus, errorThrown) {
                                layer.alert('操作失败！！！' + XMLHttpRequest.status + "|" + XMLHttpRequest.readyState + "|" + textStatus, { icon: 5 });
                            }
                        });
                    });

                    submit.trigger('click');
                },
                btn2: function (index, layero) {
                    layer.close(index);
                }

            });
        }

        $(document).click(function (e) { // 在页面任意位置点击而触发此事件
            if ($(e.target).attr('class') === "layui-tree-txt") { // 防止因为点击展开按钮把已选中的样式取消
                $(".layui-tree-txt").removeClass("tree-txt-active"); // 移除点击样式
                $(e.target).addClass("tree-txt-active"); // e.target表示被点击的目标
            }
        });

        function f_reload()
        {
            table.reload('munu-table', {
                page: {
                    curr: 1 //重新从第 1 页开始
                }
                , where: {
                   T_type: $("#T_type").val()
                }
            }, 'data');
        }
    });

</script>