@{
    ViewData["Title"] = "Add";
}

<style type="text/css">
    .downpanel .layui-select-title span { line-height: 38px; }

    /*继承父类颜色*/
    .downpanel dl dd:hover { background-color: inherit; }
</style>

<div class="layui-form layui-form-pane" action="">
    @Html.Hidden("id")

    <div class="layui-card">
        <div class="layui-card-header">角色信息</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label required">角色名称</label>
                    <div class="layui-input-inline">
                        <input type="text" name="RoleName" id="RoleName" autocomplete="off" placeholder="角色名称" class="layui-input" lay-verify="required">
                    </div>
                </div>
                @*<label class="layui-form-label " style="padding-left:0px;">公客查看</label>
        <div class="layui-input-inline">
            <select id="PublicAuth" name="PublicAuth" autocomplete="off" class="layui-input" lay-verify="required">
                <option value="">请选择</option>
                <option value=1>是</option>
                <option value=0>否</option>
            </select>
        </div>*@
                <div class="layui-inline">
                    <label class="layui-form-label required" style="padding-left:0px;">私客权限</label>
                    <div class="layui-input-inline">
                        <select id="DataAuth" name="DataAuth" autocomplete="off" class="layui-input" lay-verify="required">
                            <option value="">请选择</option>
                            <option value=0>无</option>
                            <option value=1>本人</option>
                            <option value=2>本部</option>
                            <option value=3>本部及下级</option>
                            <option value=4>全部</option>
                        </select>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label required">角色排序</label>
                    <div class="layui-input-inline">
                        <input type="number" name="RoleSort" id="RoleSort" autocomplete="off" placeholder="角色排序" class="layui-input" lay-verify="required">
                    </div>


                </div>
            </div>

            <div class="layui-form-item">
                <label class="layui-form-label">角色描述</label>
                <div class="layui-input-block">
                    <input type="text" name="RoleDscript" id="RoleDscript" autocomplete="off" placeholder="角色描述" class="layui-input">
                </div>
            </div>
            <div class="layui-form-item layui-hide">
                <input type="button" lay-submit lay-filter="LAY-user-front-submit" id="LAY-user-front-submit" value="确认">
            </div>
        </div>
    </div>
</div>
<div class="layui-card">
    @*<div class="layui-card-header">角色信息</div>*@

    <div class="layui-card-body">
        <table id="munu-table" class="layui-table" lay-filter="currentTableFilter"></table>
    </div>
</div>
<script type="text/html" id="toolbarDemo">
    <div class="layui-btn-container">
        <button class="layui-btn layui-btn-sm layui-btn-normal" lay-event="add">添加</button>
    </div>
</script>
<!-- 操作列 -->
<script type="text/html" id="auth-state">
    <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
</script>
<script>
    var id = null;
    layui.use(['table', 'tree', 'form', 'layer'], function () {
        var table = layui.table,
            tree = layui.tree,
            form = layui.form,
            layer = layui.layer,
            $ = layui.$;

        form.render("select");
    });
</script>

